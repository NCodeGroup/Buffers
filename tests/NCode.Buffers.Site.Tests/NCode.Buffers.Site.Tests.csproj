<Project Sdk="Microsoft.NET.Sdk">
  <!-- The documentation site's samples (ADR-1010). The library grants this assembly no InternalsVisibleTo, and its namespace is outside NCode.Buffers, so a sample compiles only as a consumer's code would. It references no coverage collector: build/Test-Coverage.ps1 measures the library through NCode.Buffers.Tests alone. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SiteSamples</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NCode.Buffers\NCode.Buffers.csproj" />
  </ItemGroup>
</Project>
