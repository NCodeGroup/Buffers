<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>A high-performance .NET library providing secure memory management, zero-allocation buffer utilities, and efficient string splitting operations.</Description>
    <PackageTags>crypto secure buffer pin zero poh encoding</PackageTags>
    <!-- Every pack is checked for compatibility with the last package on nuget.org (ADR-1001); the first change after a release raises it. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>4.1.0</PackageValidationBaselineVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="Nerdbank.Streams" />
  </ItemGroup>
</Project>
