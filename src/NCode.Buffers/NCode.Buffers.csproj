<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Pinned, pooled .NET buffers that zero themselves on dispose, for keys and other secrets, plus fixed-size buffer writers and string splitting without substring copies.</Description>
    <PackageTags>crypto secure buffer pin zero poh encoding</PackageTags>
    <!-- Every pack is checked for compatibility with the last package on nuget.org (ADR-1001); raise-baseline.yml raises it after each release (project-template ADR-0150). -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>5.1.3</PackageValidationBaselineVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Build-time only: the attributes are [Conditional("JETBRAINS_ANNOTATIONS")], so none reaches the assembly, and PrivateAssets keeps the package out of the nuspec (ADR-1022). -->
    <PackageReference Include="JetBrains.Annotations" PrivateAssets="all" />
    <PackageReference Include="Nerdbank.Streams" />
  </ItemGroup>
</Project>
