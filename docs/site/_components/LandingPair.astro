---
// "The same method, twice" on the landing page: the usual code and the fix, each on a panel of its own,
// one above the other so that a line of either sample is never cut. Write each side as a <div> holding Markdown: a
// label, the <Pinned> sample and its <PinNotes>.
// Usage:
//   <LandingPair>
//   <div>
//   **The usual code**
//   ...
//   </div>
//   <div>
//   ...
//   </div>
//   </LandingPair>
---

<div class="landing-pair">
  <slot />
</div>

<style>
  .landing-pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
  }
  .landing-pair > :global(div) {
    min-width: 0;
    padding: var(--space-5);
    border: var(--border-hair) solid var(--color-border);
    border-radius: var(--radius-panel);
    background: var(--color-surface);
  }
  .landing-pair > :global(div > :first-child) { margin-top: 0; }
  @media (max-width: 50rem) {
    .landing-pair > :global(div) { padding: var(--space-3); }
  }
</style>
