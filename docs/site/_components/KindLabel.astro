---
// The kind of a page, as a small engraved label under its title: what the page is for. Front matter
// cannot carry the kind, because the toolchain's contract allows no such key, so each page places this as its first
// line of content.
// Usage: <KindLabel kind="how-to" />
interface Props {
  kind: 'tutorial' | 'how-to' | 'explanation' | 'reference';
}
const labels = {
  tutorial: ['Tutorial', 'learn by doing'],
  'how-to': ['Guide', 'reach a goal'],
  explanation: ['Concept', 'understand why'],
  reference: ['Reference', 'look it up'],
} as const;
const { kind } = Astro.props;
const label = labels[kind];
if (!label) throw new Error(`[site] <KindLabel kind="${kind}">: the kind is tutorial, how-to, explanation or reference`);
const [name, purpose] = label;
---

<p class="page-kind not-content">
  <span class="page-kind__name">{name}</span><span class="page-kind__colon">: </span><span class="page-kind__purpose"
    >{purpose}</span
  >
</p>

<style>
  .page-kind {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0 0 var(--space-5);
    padding: 0.1875rem 0.625rem;
    border: var(--border-hair) solid var(--color-border);
    border-radius: var(--radius-plate);
    background: var(--color-surface-sunken);
    font-family: var(--font-sans);
    line-height: 1.3;
  }
  .page-kind__name {
    font-size: var(--text-2xs);
    font-stretch: var(--width-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text);
  }
  /* The colon is for a screen reader and for copied text; the gap separates the two words on screen. */
  .page-kind__colon {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .page-kind__purpose {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }
</style>
