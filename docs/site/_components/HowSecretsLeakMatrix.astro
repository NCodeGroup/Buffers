---
// The matrix on /concepts/how-secrets-leak/: each of the nine leak cards against what NCode.Buffers uses for it, with
// the card's verdict. It renders leaks.json, where each card's `mechanism` and verdict live once, so the matrix and
// the cards cannot disagree. Usage: <HowSecretsLeakMatrix />
import { Status } from '@ncodegroup/docs/components';
import { inline, leakHref, leaks } from '@site/components/lib/evidence';

const verdicts = leaks.verdicts as Record<string, { label: string; state: 'success' | 'warning' | 'off' }>;
---

<table class="matrix not-content">
  <thead>
    <tr>
      <th scope="col">Leak</th>
      <th scope="col">What the library uses</th>
      <th scope="col">Verdict</th>
    </tr>
  </thead>
  <tbody>
    {leaks.leaks.map((card) => (
      <tr>
        <th scope="row">
          <span class="matrix__id">{card.id}</span>
          <a href={leakHref(card.id)}>{card.title}</a>
        </th>
        <td set:html={inline(card.mechanism)} />
        <td><Status state={verdicts[card.verdict].state}>{verdicts[card.verdict].label}</Status></td>
      </tr>
    ))}
  </tbody>
</table>

<style>
  .matrix {
    width: 100%;
    margin-block: var(--nc-space-5);
    border-collapse: collapse;
    font-size: var(--sl-text-sm);
    line-height: 1.3;
    color: var(--nc-color-text);
  }
  .matrix th,
  .matrix td { padding: var(--nc-space-3) var(--nc-space-3); border-bottom: var(--nc-border-hair) solid var(--nc-color-border); text-align: start; vertical-align: top; }
  .matrix thead th {
    font-size: 0.6875rem;
    font-stretch: var(--nc-type-label-stretch);
    font-weight: 600;
    letter-spacing: var(--nc-type-label-tracking);
    text-transform: uppercase;
    color: var(--nc-color-text-muted);
  }
  .matrix tbody th { font-weight: 600; }
  .matrix__id {
    display: inline-block;
    min-width: 1.75rem;
    margin-inline-end: var(--nc-space-2);
    padding: 0.0625rem 0.3125rem;
    border-radius: var(--nc-radius-plate);
    background: var(--nc-color-screen);
    color: var(--nc-color-on-screen);
    font-family: var(--nc-font-mono);
    font-stretch: var(--nc-type-code-stretch);
    font-size: var(--sl-text-2xs);
    text-align: center;
  }
  .matrix a { color: var(--nc-color-text); text-decoration-color: var(--nc-color-border-strong); text-underline-offset: 0.2em; }
  .matrix a:hover { color: var(--nc-color-primary-text); }
  .matrix a:focus-visible { outline: var(--nc-focus-width) solid var(--nc-color-focus); outline-offset: var(--nc-focus-gap); }
  .matrix :global(code) { font-family: var(--nc-font-mono); font-stretch: var(--nc-type-code-stretch); font-size: 0.88em; }
  .matrix td:last-child { white-space: nowrap; }
  @media (max-width: 40rem) {
    .matrix thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .matrix,
    .matrix tbody,
    .matrix tr,
    .matrix th,
    .matrix td { display: block; }
    .matrix tr { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--nc-space-1) var(--nc-space-3); padding: var(--nc-space-3) 0; border-bottom: var(--nc-border-hair) solid var(--nc-color-border); }
    .matrix th,
    .matrix td { padding: 0; border: 0; }
    .matrix tbody th { grid-column: 1; }
    .matrix td:last-child { grid-column: 2; grid-row: 1; }
    .matrix td:nth-child(2) { grid-column: 1 / -1; color: var(--nc-color-text-secondary); }
  }
</style>
