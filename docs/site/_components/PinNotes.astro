---
// The list under a pinned sample: one item per pin, in the same order, each numbered with the same pin.
// Write a Markdown numbered list inside it; end an item with its leak card, <LeakCard leak="L2" />, which opens in
// place. The heading above it is the page's own: "Leaves behind" under the usual code, "What changed" under the fix.
//   tone="usual" | "fix"   the same as the <Pinned> sample above it
// Usage:
//   <PinNotes tone="usual">
//   1. The expected MAC, in an array nothing clears. <LeakCard leak="L2" />
//   2. A comparison that stops at the first difference. <LeakCard leak="L7" />
//   </PinNotes>
interface Props {
  tone?: 'usual' | 'fix';
}
const { tone = 'usual' } = Astro.props;
---

<div class:list={['pin-notes', `pin-notes--${tone}`]}>
  <slot />
</div>

<style>
  .pin-notes :global(ol) {
    display: grid;
    /* minmax(0, …): an item never widens past the column, whatever unbreakable text it holds. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: pin;
  }
  .pin-notes :global(ol > li) {
    position: relative;
    margin: 0;
    padding-inline-start: 2.25rem;
    counter-increment: pin;
  }
  .pin-notes :global(ol > li::before) {
    content: counter(pin);
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.125rem;
    display: grid;
    place-items: center;
    min-width: 1.375rem;
    height: 1.375rem;
    border-radius: var(--radius-round);
    background: var(--color-screen);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    line-height: 1;
  }
  .pin-notes--usual :global(ol > li::before) { color: var(--color-screen-hot); box-shadow: inset 0 0 0 1.5px var(--color-screen-hot); }
  .pin-notes--fix :global(ol > li::before) { color: var(--color-screen-lit); box-shadow: inset 0 0 0 1.5px var(--color-screen-lit); }
  .pin-notes :global(ol > li > p) { margin: 0; }
</style>
