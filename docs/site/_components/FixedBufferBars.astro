---
// The fixed-buffer bars: a 64-byte fixed buffer drawn three times, as a grid of 64 cells each, to show which cells
// GetSpan returns and what Reset() does to the cells that were written. A drawing, not a trace: it shows the rules the
// guide states, from no run of code.
//
// Without JavaScript and in print it renders completely: it has no script, and nothing moves. Every bar carries a text
// legend, so nothing depends on colour: the cells differ by the letter in them, by an outline or a fill, and the legend
// counts them in words.
//
// No props. Usage: <FixedBufferBars />
import { inline } from '@site/components/lib/evidence';

interface LegendItem {
  kind: string;
  spoken: string;
  text: string;
}

interface Bar {
  id: string;
  title: string;
  count: string;
  /** The cell kinds from the first cell: how many written, zeroed, returned and free; the rest of the 64 are free. */
  written: number;
  zeroed: number;
  returned: number;
  /** The legend, written from the bar's own numbers, so no count is typed twice. */
  legend: (bar: Bar) => LegendItem[];
  note?: string;
}

const size = 64;

/** The cells of a bar that none of the other kinds claims. */
const free = (bar: Bar) => size - bar.written - bar.zeroed - bar.returned;

const bars: Bar[] = [
  {
    id: 'empty',
    title: '`GetSpan(4)` on an empty writer',
    count: 'Count is 0',
    written: 0,
    zeroed: 0,
    returned: 64,
    legend: (bar) => [
      { kind: 'returned', spoken: 'returned', text: `${bar.returned} cells are free, and \`GetSpan\` returns all ${bar.returned}.` },
    ],
    note: 'The hint of 4 does not limit the span.',
  },
  {
    id: 'advanced',
    title: 'After `Advance(20)`',
    count: 'Count is 20',
    written: 20,
    zeroed: 0,
    returned: 44,
    legend: (bar) => [
      { kind: 'written', spoken: 'written', text: `${bar.written} cells are written.` },
      { kind: 'returned', spoken: 'returned', text: `${bar.returned} cells are free, and \`GetSpan\` returns all ${bar.returned}.` },
    ],
  },
  {
    id: 'reset',
    title: 'After `Reset()`',
    count: 'Count is back at 0',
    written: 0,
    zeroed: 20,
    returned: 0,
    legend: (bar) => [
      { kind: 'zero', spoken: 'zeros', text: `${bar.zeroed} cells were written and are now zeros.` },
      { kind: 'free', spoken: 'free', text: `${free(bar)} cells were never written.` },
    ],
    note: '`Clear()` also sets the count to 0, and leaves the 20 cells as they were.',
  },
];

const kinds: Record<string, { label: string }> = {
  written: { label: 'W' },
  zero: { label: '00' },
  returned: { label: 'R' },
  free: { label: '' },
};

/** The 64 cells of a bar, from the first: written, then zeroed, then returned, then free. */
function cells(bar: Bar) {
  return Array.from({ length: size }, (_, index) => {
    const kind =
      index < bar.written ? 'written' : index < bar.written + bar.zeroed ? 'zero' : index < bar.written + bar.zeroed + bar.returned ? 'returned' : 'free';
    return { kind, text: kinds[kind].label };
  });
}

const plain = (text: string) => text.replace(/`/g, '');
---

<figure class="bars not-content" aria-labelledby="fixed-buffer-bars-caption">
  <div class="bars__row">
    {bars.map((bar) => (
      <section class="bar" aria-label={`${plain(bar.title)}: ${bar.count}`}>
        <p class="bar__title" set:html={inline(bar.title)} />
        <p class="bar__count">{bar.count}</p>
        <div class="bar__cells" aria-hidden="true">
          {cells(bar).map((cell) => (
            <span class:list={['cell', `cell--${cell.kind}`]}>{cell.text}</span>
          ))}
        </div>
        <ul class="bar__legend" aria-label="What the cells mean">
          {bar.legend(bar).map((item) => (
            <li>
              <span class:list={['cell', 'cell--key', `cell--${item.kind}`]} aria-hidden="true">{kinds[item.kind].label}</span>
              <span><span class="bar__spoken">{item.spoken[0].toUpperCase() + item.spoken.slice(1)}:</span> <span set:html={inline(item.text)} /></span>
            </li>
          ))}
        </ul>
        {bar.note && <p class="bar__note" set:html={inline(bar.note)} />}
      </section>
    ))}
  </div>
  <figcaption class="bars__caption" id="fixed-buffer-bars-caption">
    A 64-byte fixed buffer, three times. <span set:html={inline('`GetSpan` returns every free cell, whatever the hint.')} />
    <span set:html={inline('`Reset()` zeros the cells written since the last `Clear()` and sets the count to 0.')} />
  </figcaption>
</figure>

<style>
  /* Nothing here moves, so there is no motion to switch off under prefers-reduced-motion. */
  .bars {
    margin: var(--nc-space-6) 0;
    padding: var(--nc-space-5);
    border: var(--nc-border-hair) solid var(--nc-color-border);
    border-radius: var(--nc-radius-module);
    background: var(--nc-color-surface);
    box-shadow: var(--nc-elevation-flush);
    color: var(--nc-color-text);
  }
  .bars p,
  .bars ul { margin: 0; }
  .bars__row { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: var(--nc-space-5); }
  .bar { display: grid; align-content: start; gap: var(--nc-space-3); }
  .bar__title { font-size: var(--sl-text-sm); font-weight: 600; }
  .bar__title :global(code),
  .bar__legend :global(code),
  .bar__note :global(code),
  .bars__caption :global(code) { font-family: var(--nc-font-mono); font-stretch: var(--nc-type-code-stretch); font-size: 0.92em; }
  .bar__count {
    font-size: 0.6875rem;
    font-stretch: var(--nc-type-label-stretch);
    font-weight: 600;
    letter-spacing: var(--nc-type-label-tracking);
    text-transform: uppercase;
    color: var(--nc-color-text-muted);
  }
  .bar__cells {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 3px;
    padding: var(--nc-space-3);
    border-radius: var(--nc-radius-panel);
    background: var(--nc-color-screen);
  }

  .cell {
    display: grid;
    place-items: center;
    height: 1.625rem;
    border-radius: var(--nc-radius-cell);
    font-family: var(--nc-font-mono);
    font-stretch: var(--nc-type-code-stretch);
    font-size: var(--sl-text-2xs);
    font-weight: 500;
    line-height: 1;
    font-feature-settings: 'zero' 1;
  }
  .cell--key { flex: none; width: 1.625rem; height: 1.25rem; }
  .cell--written {
    background: color-mix(in srgb, var(--nc-color-screen-hot) 16%, var(--nc-color-screen-raised));
    color: var(--nc-color-screen-hot);
  }
  .cell--returned {
    background: var(--nc-color-screen-raised);
    box-shadow: inset 0 0 0 1px var(--nc-color-screen-lit);
    color: var(--nc-color-screen-lit);
  }
  .cell--zero {
    box-shadow: inset 0 0 0 1px var(--nc-color-screen-border);
    color: var(--nc-color-on-screen-muted);
  }
  .cell--free { box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--nc-color-screen-border) 60%, transparent); }

  .bar__legend { display: grid; gap: var(--nc-space-2); padding: 0; list-style: none; font-size: var(--sl-text-xs); line-height: 1.3; }
  .bar__legend li { display: flex; align-items: baseline; gap: var(--nc-space-3); }
  .bar__spoken { font-weight: 600; }
  .bar__note { font-size: var(--sl-text-xs); line-height: 1.3; color: var(--nc-color-text-secondary); }
  .bars__caption {
    margin-top: var(--nc-space-5);
    font-size: var(--sl-text-xs);
    line-height: 1.5;
    color: var(--nc-color-text-secondary);
  }
</style>
