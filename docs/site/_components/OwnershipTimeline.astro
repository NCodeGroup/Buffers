---
// The timeline on /concepts/ownership/: one lane per kind of owner and four stops, drawn in the memory strip's cells:
// when you get the memory, while you use it, at Dispose, and what a view you kept reads afterwards. It
// draws the table above it on the page, so it carries no fact the table does not. Static: no script.
// Usage: <OwnershipTimeline />
//
// A stop's cells are tokens separated by spaces: `s` the key, `0` zeros, `?` not written yet, `o` other data,
// `.` free. Text fields take `code`.
import KindMark from '@site/components/KindMark.astro';
import { inline } from '@site/components/lib/evidence';

type Stop = { cells?: string; text: string };
type Lane = { owner: string; stops: [Stop, Stop, Stop, Stop] };

const stops = ['You get it', 'In use', '`Dispose`', 'Afterwards'];
const lanes: Lane[] = [
  {
    owner: '`IMemoryOwner<T>` from `Rent`, sensitive',
    stops: [
      { cells: '? ? ? ?', text: 'Not cleared: write first' },
      { cells: 's s ? ?', text: 'The key, then the rest of the page' },
      { cells: '0 0 0 0', text: 'Zeroed, back to the pool' },
      { cells: 'o o o o', text: 'May be another caller’s data' },
    ],
  },
  {
    owner: '`SecureArrayLifetime<T>`',
    stops: [
      { cells: '? ? ? ?', text: 'Not cleared: write first' },
      { cells: 's s s s', text: 'The key' },
      { cells: '0 0 0 0', text: 'Zeroed; nothing is freed' },
      { cells: '0 0 0 0', text: 'The same array, all zeros' },
    ],
  },
  {
    owner: '`SecureSpanLifetime<T>`',
    stops: [
      { cells: 's s s s', text: 'Memory you already have' },
      { cells: 's s s s', text: 'The key' },
      { cells: '0 0 0 0', text: 'Zeroed; nothing is released' },
      { cells: '0 0 0 0', text: 'The same memory, still its owner’s' },
    ],
  },
  {
    owner: '`Sequence<T>` from `CreatePooledBufferWriter`',
    stops: [
      { cells: '. . . .', text: 'Empty; segments come as you write' },
      { cells: 's s s s', text: 'The key, in one or more segments' },
      { cells: '0 0 0 0', text: 'Segments zeroed, back to the pool' },
      { cells: 'o o o o', text: 'May be another caller’s data' },
    ],
  },
  {
    owner: '`RefSpanLease<T>` from `GetSpanLease`',
    stops: [
      { text: 'A span, and an owner when the data was copied' },
      { cells: 's s s s', text: 'The key, or a copy of it' },
      { text: 'Disposes its owner, if it has one' },
      { text: 'Whatever its owner left there' },
    ],
  },
];

const kinds: Record<string, { kind: string; text: string }> = {
  s: { kind: 'secret', text: '5A' },
  '0': { kind: 'zero', text: '00' },
  '?': { kind: 'unknown', text: '??' },
  o: { kind: 'other', text: '' },
  '.': { kind: 'free', text: '' },
};
---

<figure class="timeline not-content" aria-labelledby="ownership-timeline-caption">
  <div class="timeline__grid" role="table" aria-label="What each owner holds at four moments">
    <div class="timeline__row timeline__row--head" role="row">
      <span role="columnheader" class="timeline__owner-head">Owner</span>
      {stops.map((stop, index) => (
        <span role="columnheader" class="timeline__stop-head">
          <span class="timeline__n">{index + 1}</span>
          <span set:html={inline(stop)} />
        </span>
      ))}
    </div>
    {lanes.map((lane) => (
      <div class="timeline__row" role="row">
        <span role="rowheader" class="timeline__owner" set:html={inline(lane.owner)} />
        {lane.stops.map((stop, index) => (
          <span role="cell" class:list={['timeline__stop', index === 2 && 'timeline__stop--dispose']}>
            <span class="timeline__label" aria-hidden="true"><span class="timeline__n">{index + 1}</span><span set:html={inline(stops[index])} /></span>
            {stop.cells && (
              <span class="timeline__cells" aria-hidden="true">
                {stop.cells.split(' ').map((code) => (
                  <span class:list={['cell', `cell--${kinds[code].kind}`]}>{kinds[code].text}</span>
                ))}
              </span>
            )}
            <span class="timeline__text">{stop.text}</span>
          </span>
        ))}
      </div>
    ))}
  </div>
  <figcaption id="ownership-timeline-caption" class="timeline__caption">
    <span>Each kind of owner at four moments; the last is what a span you kept reads after <code>Dispose</code>. A cell stands for a part of the memory, and <code>5A</code> marks the key.</span>
    <span class="timeline__kind">
      <KindMark kind="illustration" variant="bare" />
      <span>A drawing of the mechanism, not a trace of a real process.</span>
    </span>
  </figcaption>
</figure>

<style>
  .timeline {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-6) 0;
    padding: var(--space-5);
    border: var(--border-hair) solid var(--color-border);
    border-radius: var(--radius-module);
    background: var(--color-surface);
    box-shadow: var(--elevation-flush);
    color: var(--color-text);
  }
  .timeline__grid {
    display: grid;
    gap: 2px;
    padding: var(--space-3);
    border-radius: var(--radius-panel);
    background: var(--color-screen);
    color: var(--color-on-screen);
  }
  .timeline__row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
    align-items: start;
    padding: var(--space-3) var(--space-2);
  }
  .timeline__row + .timeline__row:not(.timeline__row--head) { border-top: 1px solid var(--color-screen-border); }
  .timeline__row--head > span {
    font-size: var(--text-2xs);
    font-stretch: var(--width-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-on-screen-muted);
  }
  .timeline__stop-head { display: flex; align-items: center; gap: var(--space-2); }
  .timeline__row--head :global(code) { font-family: var(--font-mono); text-transform: none; letter-spacing: 0; }
  .timeline__n {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: var(--radius-round);
    box-shadow: inset 0 0 0 1px var(--color-screen-border);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-on-screen-secondary);
  }
  .timeline__owner { grid-column: 1 / -1; font-size: var(--text-sm); font-weight: var(--weight-semibold); line-height: var(--leading-snug); overflow-wrap: anywhere; }
  .timeline__owner-head { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .timeline__owner :global(code) { font-family: var(--font-mono); font-stretch: var(--width-code); font-size: 0.92em; color: var(--color-screen-lit); }
  .timeline__stop { display: grid; gap: var(--space-2); min-width: 0; }
  .timeline__label { display: none; }
  .timeline__cells { display: grid; grid-template-columns: repeat(4, minmax(0, 1.875rem)); gap: 3px; }
  .timeline__text { font-size: var(--text-xs); line-height: var(--leading-snug); color: var(--color-on-screen-secondary); }
  .timeline__stop--dispose .timeline__text { color: var(--color-on-screen); }

  .cell {
    display: grid;
    place-items: center;
    height: 1.5rem;
    border-radius: var(--radius-cell);
    font-family: var(--font-mono);
    font-stretch: var(--width-code);
    font-size: 0.6875rem;
    font-weight: var(--weight-medium);
    line-height: 1;
    font-feature-settings: 'zero' 1;
  }
  .cell--free { box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-screen-border) 60%, transparent); }
  .cell--other { background: var(--color-screen-raised); }
  .cell--secret { background: color-mix(in srgb, var(--color-screen-hot) 16%, var(--color-screen-raised)); color: var(--color-screen-hot); }
  .cell--zero { box-shadow: inset 0 0 0 1px var(--color-screen-border); color: var(--color-on-screen-muted); }
  .cell--unknown { box-shadow: inset 0 0 0 1px var(--color-screen-border); color: var(--color-on-screen-secondary); }

  .timeline__caption { display: grid; gap: var(--space-2); font-size: var(--text-md); line-height: var(--leading-normal); }
  .timeline__caption code { font-family: var(--font-mono); font-size: 0.88em; }
  .timeline__kind { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); color: var(--color-text-secondary); font-size: var(--text-sm); }

  /* Below the width of four stops, each lane becomes a card of four labeled stops, two by two. */
  @media (max-width: 52rem) {
    .timeline { padding: var(--space-4); }
    .timeline__row--head { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .timeline__row { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3) var(--space-4); }
    .timeline__label { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-2xs); color: var(--color-on-screen-muted); }
    .timeline__label :global(code) { font-family: var(--font-mono); }
  }
</style>
