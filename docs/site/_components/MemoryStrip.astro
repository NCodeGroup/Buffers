---
// The memory strip: memory drawn as rows of cells, stepped through a script of frames, one caption per
// track and frame. Every picture of memory on the site is this component with another script from
// docs/site/_components/data/strips.json, so a reader learns the drawing once.
//
// Without JavaScript, and in print, every frame shows as a numbered sequence with its captions. With JavaScript, a
// strip with a stepper shows one frame at a time, with Back, Next, a slider and the arrow keys; the step is kept in
// the URL fragment (#<script>-<step>). The switch "What a memory dump taken now would show" outlines every cell that
// holds the key, and needs no script. Nothing moves on its own, and nothing animates.
//
// Props:
//   script    a key of strips.json, such as "life-of-a-key"
//   frames    the steps to show, such as "1,3,5"; default all
//   stepper   false shows the frames as a sequence even with JavaScript; default true when there is more than one
//   outside   false leaves out the "Outside this picture" line; default true
//   id        the strip's anchor, and the prefix of its frames' anchors; default the script's name. Give each strip
//             its own when a page shows one script twice
// Usage: <MemoryStrip script="life-of-a-key" />  ·  <MemoryStrip script="life-of-a-key" frames="1,3,5" stepper={false} />
import { Readout } from '@ncode/docs/components';
import Brace from '@site/components/Brace.astro';
import KindMark from '@site/components/KindMark.astro';
import strips from '@site/components/data/strips.json';
import { claim as findClaim, claimHref, inline, leak as findLeak, leakHref, sitePath } from '@site/components/lib/evidence';

interface Props {
  script: string;
  frames?: string;
  stepper?: boolean;
  outside?: boolean;
  id?: string;
}
type Track = { id: string; label: string; code?: string };
type Region = { id: string; label: string };
type TrackFrame = { cells: Record<string, string>; count: number; caption: string; scope?: string; refs?: string[] };
type Frame = { title: string; tracks: Record<string, TrackFrame> };
type Script = {
  title: string;
  summary: string;
  key: string[];
  tracks: Track[];
  regions: Record<string, Region[]>;
  frames: Frame[];
};

const { script: name, frames: only, outside = true } = Astro.props;
const script = (strips as unknown as Record<string, Script>)[name];
if (!script) throw new Error(`[memory strip] no script "${name}" in docs/site/_components/data/strips.json`);
const steps = script.frames
  .map((frame, index) => ({ ...frame, step: index + 1 }))
  .filter((frame) => !only || only.split(',').map(Number).includes(frame.step));
const stepper = Astro.props.stepper ?? steps.length > 1;

const kinds: Record<string, { label: string; spoken: string }> = {
  '.': { label: '', spoken: 'free' },
  o: { label: '', spoken: 'other data' },
  s: { label: '', spoken: 'the key' },
  x: { label: '', spoken: 'an old copy of the key' },
  '0': { label: '00', spoken: 'zeros' },
  '?': { label: '??', spoken: 'not written yet' },
};
const cellClass: Record<string, string> = { '.': 'free', o: 'other', s: 'secret', x: 'stale', '0': 'zero', '?': 'unknown' };

/** The cells of one region, eight to a line, with each run of key cells numbered from the key's first byte. */
function cells(pattern: string) {
  const flat = pattern.replace(/\s+/g, '');
  let run = 0;
  return [...flat].map((code, index) => {
    const isKey = code === 's' || code === 'x';
    run = isKey && index > 0 && (flat[index - 1] === 's' || flat[index - 1] === 'x') ? run + 1 : 0;
    const text = isKey ? script.key[run % script.key.length] : kinds[code]?.label ?? '';
    if (!(code in kinds)) throw new Error(`[memory strip] "${name}": unknown cell "${code}"`);
    return { code, text, kind: cellClass[code] };
  });
}

function refLink(ref: string) {
  if (/^L\d$/.test(ref)) return { href: leakHref(ref), text: ref, title: findLeak(ref).title };
  return { href: claimHref(ref), text: ref, title: findClaim(ref).title };
}

const id = Astro.props.id ?? name;
---

<figure class="strip not-content" id={id} data-strip={stepper ? '' : undefined} data-total={script.frames.length} aria-labelledby={`${id}-title`}>
  <div class="strip__head">
    <p class="strip__title" id={`${id}-title`}>{script.title}</p>
    <p class="strip__summary" set:html={inline(script.summary)} />
    <div class="strip__tools">
      <label class="strip__dump">
        <input type="checkbox" />
        <span class="strip__switch" aria-hidden="true"></span>
        <span>What a memory dump taken now would show</span>
      </label>
      <ul class="strip__legend" aria-label="What the cells mean">
        <li><span class="cell cell--secret" aria-hidden="true">{script.key[0]}</span>The key</li>
        <li><span class="cell cell--stale" aria-hidden="true">{script.key[0]}</span>An old copy</li>
        <li><span class="cell cell--zero" aria-hidden="true">00</span>Zeros</li>
        <li><span class="cell cell--unknown" aria-hidden="true">??</span>Not written yet</li>
        <li><span class="cell cell--other" aria-hidden="true"></span>Other data</li>
      </ul>
    </div>
  </div>

  {stepper && (
    <div class="strip__controls" hidden>
      <button type="button" class="strip__key" data-back>Back</button>
      <input type="range" min="1" max={steps.length} value="1" step="1" aria-label="Step" />
      <button type="button" class="strip__key" data-next>Next</button>
      <p class="strip__status" aria-live="polite"></p>
    </div>
  )}

  <ol class="strip__frames">
    {steps.map((frame) => (
      <li class="strip__frame" id={`${id}-${frame.step}`} data-title={frame.title} data-step={frame.step}>
        <p class="strip__step">
          <span class="strip__number">{frame.step}</span>
          <span>{frame.title}</span>
        </p>
        <div class="strip__tracks">
          {script.tracks.map((track) => {
            const state = frame.tracks[track.id];
            return (
              <section class="track" aria-label={`${track.label.replace(/`/g, '')}, step ${frame.step}`}>
                <div class="track__screen">
                  <p class="track__label">
                    <span set:html={inline(track.label)} />
                    {track.code && <code class="track__code">{track.code}</code>}
                  </p>
                  <div class="track__regions" aria-hidden="true">
                    {script.regions[track.id].map((region) => (
                      <div class="region">
                        <span class="region__label">{region.label}</span>
                        <div class:list={['region__body', state.scope === region.id && 'region__body--scope']}>
                          {state.scope === region.id && <Brace side="left" />}
                          <div class="region__cells">
                            {cells(state.cells[region.id] ?? '').map((cell) => (
                              <span class:list={['cell', `cell--${cell.kind}`]}>{cell.text}</span>
                            ))}
                          </div>
                          {state.scope === region.id && <Brace side="right" />}
                        </div>
                      </div>
                    ))}
                  </div>
                  <p class="track__count">
                    <span>Places this key can be read</span>
                    <Readout>{state.count}</Readout>
                  </p>
                </div>
                <p class="track__caption">
                  <span set:html={inline(state.caption)} />
                  {(state.refs ?? []).map((ref) => {
                    const link = refLink(ref);
                    return (
                      <a class="track__ref" href={link.href} title={link.title}>
                        {link.text}
                        <span class="sr-only">: {link.title}</span>
                      </a>
                    );
                  })}
                </p>
              </section>
            );
          })}
        </div>
      </li>
    ))}
  </ol>

  {outside && (
    <p class="strip__outside">
      <span class="strip__outside-label">Outside this picture</span>
      <span>The page file, the hibernation file, a debugger, a crash dump.</span>
      <a href={sitePath('/start/limits/')}>What it protects, and what it does not</a>
    </p>
  )}
  <p class="strip__note">
    <KindMark kind="illustration" />
    <span>A drawing of the mechanism, not a trace of a real process.</span>
  </p>
</figure>

<script>
  // Steps a strip one frame at a time. Without this script every frame shows, in order.
  for (const strip of document.querySelectorAll<HTMLElement>('[data-strip]')) {
    const frames = [...strip.querySelectorAll<HTMLElement>('.strip__frame')];
    const controls = strip.querySelector<HTMLElement>('.strip__controls');
    if (!controls || frames.length < 2) continue;
    const back = controls.querySelector<HTMLButtonElement>('[data-back]')!;
    const next = controls.querySelector<HTMLButtonElement>('[data-next]')!;
    const range = controls.querySelector<HTMLInputElement>('input[type="range"]')!;
    const status = controls.querySelector<HTMLElement>('.strip__status')!;
    let current = Math.max(0, frames.findIndex((frame) => `#${frame.id}` === location.hash));
    const show = (index: number, remember: boolean) => {
      current = Math.min(frames.length - 1, Math.max(0, index));
      frames.forEach((frame, i) => frame.classList.toggle('is-current', i === current));
      range.value = String(current + 1);
      // The script's own step number, so a strip that shows some of its frames counts as the frame's badge does.
      const label = `Step ${frames[current].dataset.step} of ${strip.dataset.total}: ${frames[current].dataset.title}`;
      range.setAttribute('aria-valuetext', label);
      status.textContent = label;
      back.disabled = current === 0;
      next.disabled = current === frames.length - 1;
      if (remember) history.replaceState(null, '', `#${frames[current].id}`);
    };
    back.addEventListener('click', () => show(current - 1, true));
    next.addEventListener('click', () => show(current + 1, true));
    range.addEventListener('input', () => show(Number(range.value) - 1, true));
    strip.addEventListener('keydown', (event) => {
      if (event.target === range || event.altKey || event.ctrlKey || event.metaKey) return;
      if (event.key === 'ArrowLeft') show(current - 1, true);
      else if (event.key === 'ArrowRight') show(current + 1, true);
      else return;
      event.preventDefault();
    });
    controls.hidden = false;
    strip.classList.add('is-stepping');
    show(current, false);
  }
</script>

<style>
  .strip {
    display: grid;
    gap: var(--space-5);
    margin: var(--space-6) 0;
    padding: var(--space-5);
    border: var(--border-hair) solid var(--color-border);
    border-radius: var(--radius-module);
    background: var(--color-surface);
    box-shadow: var(--elevation-flush);
    color: var(--color-text);
  }
  .strip p { margin: 0; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .strip__head { display: grid; gap: var(--space-3); }
  .strip__title {
    font-size: var(--text-xl);
    font-stretch: var(--width-display);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-snug);
  }
  .strip__summary { max-width: 44rem; color: var(--color-text-secondary); font-size: var(--text-md); line-height: var(--leading-normal); }
  .strip__summary :global(code) { font-family: var(--font-mono); font-stretch: var(--width-code); font-size: 0.92em; }
  .strip__tools { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-6); margin-top: var(--space-2); }

  /* The dump switch: a slide switch with I and O, no script needed. */
  .strip__dump {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--control-md);
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    cursor: pointer;
  }
  .strip__dump input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .strip__switch {
    position: relative;
    flex: none;
    width: 2.5rem;
    height: 1.375rem;
    border: var(--border-hair) solid var(--color-border-strong);
    border-radius: var(--radius-plate);
    background: var(--color-well);
    box-shadow: var(--elevation-recessed);
  }
  .strip__switch::before {
    content: 'O';
    position: absolute;
    inset-block: 2px;
    inset-inline-start: 2px;
    display: grid;
    place-items: center;
    width: 1rem;
    border-radius: 2px;
    background: var(--color-control);
    box-shadow: 0 1px 0 var(--color-lip);
    color: var(--color-text-muted);
    font-size: 0.5625rem;
    font-weight: var(--weight-bold);
    transition: transform var(--dur-move) var(--ease-out);
  }
  .strip__dump input:checked + .strip__switch { background: var(--color-warning-subtle); border-color: var(--color-warning-mark); }
  .strip__dump input:checked + .strip__switch::before { content: 'I'; transform: translateX(1.0625rem); color: var(--color-warning-text); }
  .strip__dump input:focus-visible + .strip__switch { outline: var(--focus-width) solid var(--color-focus); outline-offset: var(--focus-gap); }

  .strip__legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-control);
    background: var(--color-screen);
    list-style: none;
    color: var(--color-on-screen-secondary);
    font-size: var(--text-xs);
  }
  .strip__legend li { display: inline-flex; align-items: center; gap: var(--space-2); }
  .strip__legend .cell { width: 1.5rem; height: 1.25rem; font-size: 0.625rem; }

  /* Controls: keys on the case. */
  .strip__controls { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-4); }
  .strip__controls[hidden] { display: none; }
  .strip__key {
    min-height: var(--control-md);
    padding: 0 var(--space-5);
    border: var(--border-hair) solid var(--color-border-strong);
    border-radius: var(--radius-control);
    background: var(--color-control);
    box-shadow: inset 0 1px 0 var(--color-glint), 0 var(--travel) 0 var(--color-lip);
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    cursor: pointer;
    transition: transform var(--dur-press) var(--ease-out), box-shadow var(--dur-press) var(--ease-out);
  }
  .strip__key:hover { background: var(--color-control-hover); }
  .strip__key:active { transform: translateY(var(--travel)); box-shadow: none; }
  .strip__key:disabled { color: var(--color-text-disabled); cursor: default; }
  .strip__key:focus-visible,
  .strip__controls input:focus-visible { outline: var(--focus-width) solid var(--color-focus); outline-offset: var(--focus-gap); }
  .strip__controls input { flex: 1 1 8rem; accent-color: var(--color-primary); }
  .strip__status { flex-basis: 100%; color: var(--color-text-secondary); font-size: var(--text-md); }

  .strip__frames { display: grid; gap: var(--space-7); margin: 0; padding: 0; list-style: none; }
  .is-stepping .strip__frame:not(.is-current) { display: none; }
  .strip__frame { display: grid; gap: var(--space-4); scroll-margin-top: calc(var(--sl-nav-height) + var(--space-5)); }
  .strip__step { display: flex; align-items: center; gap: var(--space-3); font-size: var(--text-base); font-weight: var(--weight-semibold); }
  .strip__number {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--radius-plate);
    background: var(--color-surface-sunken);
    box-shadow: inset 0 0 0 1px var(--color-border);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-stretch: var(--width-code);
    font-size: var(--text-xs);
  }
  .strip__tracks { display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: var(--space-5); }

  /* A track: a screen that shows memory, and the caption under it, on the page. */
  .track { display: grid; gap: var(--space-3); align-content: start; }
  .track__screen {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4);
    border-radius: var(--radius-panel);
    background: var(--color-screen);
    color: var(--color-on-screen);
  }
  .track__label { display: grid; gap: var(--space-1); font-size: var(--text-md); font-weight: var(--weight-semibold); }
  .track__label :global(code),
  .track__code {
    font-family: var(--font-mono);
    font-stretch: var(--width-code);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    color: var(--color-on-screen-secondary);
    overflow-wrap: anywhere;
  }
  .track__label :global(code) { font-size: 0.92em; color: inherit; font-weight: inherit; }
  .track__regions { display: grid; gap: var(--space-4); }
  .region { display: grid; gap: var(--space-2); }
  .region__label {
    font-size: var(--text-2xs);
    font-stretch: var(--width-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-on-screen-muted);
  }
  .region__body { display: flex; align-items: stretch; gap: var(--space-2); color: var(--color-screen-lit); }
  .region__body:not(.region__body--scope) { padding-inline: calc(10px + var(--space-2)); }
  .region__cells { flex: 1 1 auto; display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 3px; }

  .cell {
    display: grid;
    place-items: center;
    height: 1.625rem;
    border-radius: var(--radius-cell);
    font-family: var(--font-mono);
    font-stretch: var(--width-code);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    line-height: 1;
    font-feature-settings: 'zero' 1;
  }
  .cell--free { box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-screen-border) 60%, transparent); }
  .cell--other { background: var(--color-screen-raised); }
  .cell--secret { background: color-mix(in srgb, var(--color-screen-hot) 16%, var(--color-screen-raised)); color: var(--color-screen-hot); }
  .cell--stale {
    background: repeating-linear-gradient(135deg, color-mix(in srgb, var(--color-screen-hot) 22%, transparent) 0 3px, transparent 3px 6px), var(--color-screen-raised);
    color: color-mix(in srgb, var(--color-screen-hot) 80%, var(--color-on-screen-muted));
  }
  .cell--zero { box-shadow: inset 0 0 0 1px var(--color-screen-border); color: var(--color-on-screen-muted); }
  .cell--unknown { box-shadow: inset 0 0 0 1px var(--color-screen-border); color: var(--color-on-screen-secondary); }

  /* The dump switch outlines every cell that holds the key. */
  .strip:has(.strip__dump input:checked) :is(.cell--secret, .cell--stale) {
    outline: 2px solid var(--color-warning-mark);
    outline-offset: 1px;
  }

  .track__count { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); color: var(--color-on-screen-secondary); font-size: var(--text-sm); }
  .track__caption { font-size: var(--text-md); line-height: var(--leading-normal); text-wrap: pretty; }
  .track__caption :global(code) {
    padding: 0.06em 0.3em;
    border: var(--border-hair) solid var(--color-border);
    border-radius: var(--radius-plate);
    background: var(--color-surface-sunken);
    font-family: var(--font-mono);
    font-stretch: var(--width-code);
    font-size: 0.88em;
  }
  .track__ref {
    display: inline-block;
    margin-inline-start: var(--space-2);
    padding: 0 0.3125rem;
    border: var(--border-hair) solid var(--color-border);
    border-radius: var(--radius-plate);
    color: var(--color-primary-text);
    font-family: var(--font-mono);
    font-stretch: var(--width-code);
    font-size: var(--text-xs);
    text-decoration: none;
  }
  .track__ref:hover { border-color: var(--color-border-strong); }
  .track__ref:focus-visible { outline: var(--focus-width) solid var(--color-focus); outline-offset: var(--focus-gap); }

  .strip__outside {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-control);
    font-size: var(--text-md);
  }
  .strip__outside-label {
    font-size: var(--text-2xs);
    font-stretch: var(--width-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .strip__outside a { color: var(--color-primary-text); text-underline-offset: 0.2em; }
  .strip__note { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); color: var(--color-text-secondary); font-size: var(--text-sm); }

  @media (max-width: 40rem) {
    .strip { padding: var(--space-4); border-radius: var(--radius-panel); }
    .strip__legend { gap: var(--space-2) var(--space-3); }
  }
  @media (prefers-reduced-motion: reduce) {
    .strip__switch::before,
    .strip__key { transition: none; }
  }
  @media print {
    .strip__controls { display: none; }
    .is-stepping .strip__frame:not(.is-current) { display: grid; }
  }
</style>
