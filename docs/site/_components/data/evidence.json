  "claims": [
    {
      "id": "R1",
      "anchor": "zeroed-on-dispose",
      "title": "Zeroed on dispose",
      "claim": "A buffer rented with `isSensitive: true`, a `SecureArrayLifetime<T>` and a `SecureSpanLifetime<T>` are overwritten with zeros when they are disposed. A rented buffer is zeroed whole, including the part beyond the length you asked for.",
      "kind": "asserted",
      "tests": [
        "SecureMemoryTests.Dispose_ZeroesMemory",
        "SecureArrayLifetimeTests.Dispose_ZerosMemory_ByteArray",
        "SecureArrayLifetimeTests.Dispose_ZerosMemory_CustomStruct",
        "SecureSpanLifetimeTests.Dispose_ZerosMemory_ByteSpan",
        "SecureSpanLifetimeTests.Dispose_ZerosAllBytes_LargeBuffer",
        "BufferFactoryPropertyTests.CreatePinnedArray_GivenAnyLength_ReturnsAnArrayOfThatLengthThatDisposeZeroes"
      ],
      "sources": [
        "SecureMemory.Dispose",
        "SecureArrayLifetime.Dispose",
        "SecureSpanLifetime.Dispose",
        "ZeroMemory"
      ],
      "external": [
        "ZeroMemoryDocs"
      ],
      "doesNotShow": "That your code called `Dispose`: nothing is zeroed without it, and no finalizer does it later. Copies your code made, such as a `string`, a `ToArray()` result or a buffer rented with `isSensitive: false`."
    },
    {
      "id": "R2",
      "anchor": "zeroed-before-reuse",
      "title": "Zeroed before the next renter",
      "claim": "A pooled buffer rented with `isSensitive: true` is overwritten with zeros before the pool can hand it to another caller.",
      "kind": "asserted",
      "tests": [
        "SecureMemoryPoolTests.RentedMemory_IsZeroedOnReturn",
        "SecureMemoryPoolTests.RentDisposeRent_ReusesBuffer"
      ],
      "sources": [
        "SecureMemory.Dispose",
        "SecureMemoryPool.Return"
      ],
      "doesNotShow": "Buffers rented with `isSensitive: false`: they come from `MemoryPool<T>.Shared`, which passes them on as they are. A buffer the pool allocates new: it is not cleared before you get it, so write before you read."
    },
    {
      "id": "R3",
      "anchor": "not-moved",
      "title": "Not moved by the collector",
      "claim": "The memory of a sensitive rented buffer and of a `SecureArrayLifetime<T>` is allocated pinned, on the pinned object heap. The collector does not move it, so no copy of a secret is left at an earlier address.",
      "kind": "asserted",
      "kindNote": "Through the generation the collector reports",
      "tests": [
        "SecureMemoryTests.Constructor_AllocatesOnPinnedObjectHeap",
        "BufferFactoryTests.CreatePinnedArray_AllocatesOnPinnedObjectHeap"
      ],
      "sources": [
        "SecureMemory.Allocate",
        "SecureArrayLifetime.Allocate"
      ],
      "external": [
        "AllocateUninitializedArrayDocs"
      ],
      "doesNotShow": "That an ordinary array would have moved: when the collector compacts is its decision, and no test asserts it. That the memory stays out of a page file or a crash dump. `GetSecureLifetime()` pins nothing: it zeroes memory you already have, wherever that is."
    },
