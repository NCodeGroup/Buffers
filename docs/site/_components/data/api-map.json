      "id": "buffer-factory-rent",
      "group": "secure-memory",
      "type": "BufferFactory",
      "member": "Rent",
      "signatures": [
        "public static IMemoryOwner<T> Rent<T>(int minBufferSize, bool isSensitive, out Span<T> buffer)",
        "public static IMemoryOwner<byte> Rent(int minBufferSize, bool isSensitive, out Span<byte> buffer)",
        "public static IMemoryOwner<T> Rent<T>(int minBufferSize, bool isSensitive, out Memory<T> buffer)",
        "public static IMemoryOwner<byte> Rent(int minBufferSize, bool isSensitive, out Memory<byte> buffer)"
      ],
      "summary": "Rents a buffer of at least `minBufferSize` elements from `SecureMemoryPool<T>` when `isSensitive` is true, and from `MemoryPool<T>.Shared` when it is false. Returns the owner and the buffer as a `Span<T>` or `Memory<T>` cut to the requested size.",
      "constraint": "unmanaged",
      "throws": "`ArgumentOutOfRangeException` when `minBufferSize` is negative.",
      "page": "/start/which-buffer/",
