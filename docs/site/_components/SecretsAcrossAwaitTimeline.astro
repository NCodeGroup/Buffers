---
// The timeline on /guides/secrets-across-await/: three lanes, one per place a key can be held (a method, a method
// with an await, a field), each showing when the buffer is rented, when the key is in use, when the method waits,
// and when the buffer is zeroed. It draws what the page's text says, so it carries no fact the text does not.
// Static: no script.
// Usage: <SecretsAcrossAwaitTimeline />
//
// A lane's spans are drawn left to right, each with a weight (its share of the lane's width) and a kind: `use` the
// key in use, `wait` an await, the method suspended while the key stays in its buffer, `zero` the moment Dispose
// overwrites it. Text fields take `code`.
import KindMark from '@site/components/KindMark.astro';
import { inline } from '@site/components/lib/evidence';

type Span = { kind: 'use' | 'wait' | 'zero'; weight: number; text: string };
type Lane = { name: string; code: string; spans: Span[]; rented: string };

const lanes: Lane[] = [
  {
    name: 'In one method',
    code: 'Rent(32, isSensitive: true, out Span<byte> key)',
    rented: 'Rented when the method starts',
    spans: [
      { kind: 'use', weight: 9, text: 'The key in use' },
      { kind: 'zero', weight: 1, text: 'Zeroed at the end of the `using` scope' },
    ],
  },
  {
    name: 'Across an await',
    code: 'Rent(32, isSensitive: true, out Memory<byte> key)',
    rented: 'Rented when the method starts',
    spans: [
      { kind: 'use', weight: 3, text: 'In use' },
      { kind: 'wait', weight: 4, text: '`await`: the method waits, and the key stays in its pinned buffer' },
      { kind: 'use', weight: 2, text: 'In use' },
      { kind: 'zero', weight: 1, text: 'Zeroed when the method returns, with `using var`' },
    ],
  },
  {
    name: 'In a field',
    code: 'IMemoryOwner<byte> in a class you dispose',
    rented: 'Rented at startup',
    spans: [
      { kind: 'use', weight: 2, text: 'A call' },
      { kind: 'wait', weight: 1, text: 'Idle' },
      { kind: 'use', weight: 2, text: 'A call' },
      { kind: 'wait', weight: 1, text: 'Idle' },
      { kind: 'use', weight: 2, text: 'A call' },
      { kind: 'zero', weight: 1, text: 'Zeroed by `Dispose`, at shutdown or when the key is replaced' },
    ],
  },
];
---

<figure class="await-timeline not-content" aria-labelledby="await-timeline-caption">
  <ol class="await-timeline__lanes">
    {lanes.map((lane, index) => (
      <li class="await-timeline__lane">
        <p class="await-timeline__name">
          <span class="await-timeline__n">{index + 1}</span>
          <span>{lane.name}</span>
        </p>
        <code class="await-timeline__code">{lane.code}</code>
        <div class="await-timeline__bar" aria-hidden="true">
          <span class="await-timeline__rent" title={lane.rented}></span>
          {lane.spans.map((span) => (
            <span
              class:list={['await-timeline__span', `await-timeline__span--${span.kind}`]}
              style={`flex-grow: ${span.weight}`}
            >
              {span.kind === 'zero' ? '00' : ''}
            </span>
          ))}
        </div>
        <ul class="await-timeline__legend">
          <li>
            <span class="await-timeline__mark await-timeline__mark--rent" aria-hidden="true"></span>
            <span>{lane.rented}</span>
          </li>
          {lane.spans
            .filter((span, i, all) => span.kind !== 'use' && all.findIndex((s) => s.text === span.text) === i)
            .map((span) => (
              <li>
                <span class:list={['await-timeline__mark', `await-timeline__mark--${span.kind}`]} aria-hidden="true"></span>
                <span set:html={inline(span.text)} />
              </li>
            ))}
        </ul>
      </li>
    ))}
  </ol>
  <figcaption id="await-timeline-caption" class="await-timeline__caption">
    <span>
      When each buffer is rented and when it is zeroed. The solid bar is the time the key is in use; the hatched bar
      is time the code holding it waits. The key is in memory, readable, from the first mark to the last.
    </span>
    <span class="await-timeline__kind">
      <KindMark kind="illustration" variant="bare" />
      <span>A drawing of the mechanism, not a trace of a real process.</span>
    </span>
  </figcaption>
</figure>

<style>
  .await-timeline {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-6) 0;
    padding: var(--space-5);
    border: var(--border-hair) solid var(--color-border);
    border-radius: var(--radius-module);
    background: var(--color-surface);
    box-shadow: var(--elevation-flush);
    color: var(--color-text);
  }
  .await-timeline__lanes {
    display: grid;
    gap: 0;
    margin: 0;
    padding: var(--space-2) var(--space-4);
    list-style: none;
    border-radius: var(--radius-panel);
    background: var(--color-screen);
    color: var(--color-on-screen);
  }
  .await-timeline__lane {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-4) 0;
  }
  .await-timeline__lane + .await-timeline__lane { border-top: 1px solid var(--color-screen-border); }
  .await-timeline__name {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }
  .await-timeline__n {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: var(--radius-round);
    box-shadow: inset 0 0 0 1px var(--color-screen-border);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-on-screen-secondary);
  }
  .await-timeline__code {
    font-family: var(--font-mono);
    font-stretch: var(--width-code);
    font-size: var(--text-xs);
    color: var(--color-screen-lit);
    overflow-wrap: anywhere;
  }
  .await-timeline__bar {
    display: flex;
    align-items: stretch;
    gap: 3px;
    height: 1.5rem;
    margin-block: var(--space-1);
  }
  .await-timeline__rent {
    flex: none;
    width: 0.5rem;
    border-radius: var(--radius-cell);
    background: var(--color-on-screen-secondary);
  }
  .await-timeline__span { flex-basis: 0; min-width: 0.375rem; border-radius: var(--radius-cell); }
  .await-timeline__span--use { background: color-mix(in srgb, var(--color-screen-hot) 45%, var(--color-screen-raised)); }
  .await-timeline__span--wait {
    background: repeating-linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-screen-hot) 26%, transparent) 0 3px,
      transparent 3px 7px
    );
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-screen-hot) 35%, transparent);
  }
  .await-timeline__span--zero {
    flex: none;
    display: grid;
    place-items: center;
    width: 2rem;
    box-shadow: inset 0 0 0 1px var(--color-screen-lit);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-screen-lit);
  }
  .await-timeline__legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
    color: var(--color-on-screen-secondary);
  }
  .await-timeline__legend > li { display: inline-flex; align-items: baseline; gap: var(--space-2); margin: 0; }
  .await-timeline__legend .await-timeline__mark { align-self: center; }
  .await-timeline__legend :global(code) { font-family: var(--font-mono); color: var(--color-on-screen); }
  .await-timeline__mark { flex: none; width: 0.75rem; height: 0.75rem; border-radius: 2px; }
  .await-timeline__mark--rent { width: 0.375rem; background: var(--color-on-screen-secondary); }
  .await-timeline__mark--wait {
    background: repeating-linear-gradient(135deg, color-mix(in srgb, var(--color-screen-hot) 40%, transparent) 0 2px, transparent 2px 4px);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-screen-hot) 35%, transparent);
  }
  .await-timeline__mark--zero { box-shadow: inset 0 0 0 1.5px var(--color-screen-lit); }

  .await-timeline__caption { display: grid; gap: var(--space-2); font-size: var(--text-md); line-height: var(--leading-normal); }
  .await-timeline__kind { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); color: var(--color-text-secondary); font-size: var(--text-sm); }

  @media (max-width: 40rem) {
    .await-timeline { padding: var(--space-4); }
    .await-timeline__lanes { padding: var(--space-1) var(--space-3); }
  }
</style>
