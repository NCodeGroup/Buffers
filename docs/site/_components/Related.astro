---
// The end of a page: at most four links, one per kind of page. Write a Markdown list inside it, each
// item starting with the kind in bold, so the links stay in the page where the link check reads them:
//   <Related>
//   - **Learn** [Quick start](/start/quick-start/)
//   - **Look up** [Ways to get it wrong](/reference/pitfalls/)
//   </Related>
---

<nav class="related" aria-label="Where to go next">
  <slot />
</nav>

<style>
  .related { margin-top: var(--nc-space-8); }
  .related :global(ul) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr));
    gap: var(--nc-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .related :global(li) {
    display: flex;
    flex-direction: column;
    gap: var(--nc-space-3);
    margin: 0;
    padding: var(--nc-space-4) var(--nc-space-5) var(--nc-space-5);
    border: var(--nc-border-hair) solid var(--nc-color-border);
    border-radius: var(--nc-radius-panel);
    background: var(--nc-color-surface);
    box-shadow: var(--nc-elevation-flush);
    line-height: 1.3;
  }
  .related :global(li > strong:first-child) {
    font-size: 0.6875rem;
    font-stretch: var(--nc-type-label-stretch);
    font-weight: 600;
    letter-spacing: var(--nc-type-label-tracking);
    text-transform: uppercase;
    color: var(--nc-color-text-muted);
  }
  .related :global(li a) {
    color: var(--nc-color-text);
    font-weight: 600;
    text-decoration: none;
  }
  .related :global(li a::after) { content: ' \2192'; color: var(--nc-color-text-muted); }
  .related :global(li a:hover) { color: var(--nc-color-primary-text); }
  .related :global(li > p) { display: contents; }
</style>
