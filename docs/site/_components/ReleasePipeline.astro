---
// The release process of /evidence/package/: five stages from a pull request to the pull request that raises the
// package validation baseline, each with the workflow file that does it. The stages follow the workflows in
// .github/workflows/: ci.yml, tag-release.yml, publish.yml (which calls release-provenance.yml and raise-baseline.yml).
// A static drawing: no script, the same in print.
// Usage: <ReleasePipeline />, after the table of checks it supports.
import KindMark from '@site/components/KindMark.astro';

const stages = [
  {
    title: 'A pull request',
    files: ['ci.yml'],
    note: 'Runs the gate and the coverage check.',
  },
  {
    title: 'Merge',
    files: ['tag-release.yml', 'ci.yml'],
    note: 'Runs ci.yml again on the merged commit, then tags it, signed with gitsign, and publishes the GitHub release.',
  },
  {
    title: 'Publish',
    files: ['publish.yml'],
    note: 'Tests and packs the tagged commit, and pushes to nuget.org through trusted publishing after a maintainer approves.',
  },
  {
    title: 'Provenance and SBOM',
    files: ['release-provenance.yml'],
    note: 'Attaches the provenance and an SBOM to the release.',
  },
  {
    title: 'Baseline',
    files: ['raise-baseline.yml'],
    note: 'Opens the pull request that raises the package validation baseline.',
  },
];
---

<figure class="pipeline not-content" aria-labelledby="release-pipeline-title">
  <p class="pipeline__title" id="release-pipeline-title">From a pull request to a published package</p>
  <ol class="pipeline__stages">
    {stages.map((stage) => (
      <li class="stage">
        <span class="stage__title">{stage.title}</span>
        <span class="stage__files">
          {stage.files.map((file) => <code>{file}</code>)}
        </span>
        <span class="stage__note">{stage.note}</span>
      </li>
    ))}
  </ol>
  <figcaption class="pipeline__note">
    <KindMark kind="illustration" />
    <span>A drawing of the release process</span>
  </figcaption>
</figure>

<style>
  .pipeline {
    display: grid;
    gap: var(--nc-space-4);
    margin-block: var(--nc-space-6);
    padding: var(--nc-space-5);
    border: var(--nc-border-hair) solid var(--nc-color-border);
    border-radius: var(--nc-radius-panel);
    background: var(--nc-color-surface);
    box-shadow: var(--nc-elevation-flush);
    color: var(--nc-color-text);
  }
  .pipeline p { margin: 0; }
  .pipeline__title {
    font-size: var(--sl-text-lg);
    font-stretch: var(--nc-type-heading-stretch);
    font-weight: 600;
    line-height: 1.3;
  }
  .pipeline__stages { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; counter-reset: stage; }
  .stage {
    position: relative;
    display: grid;
    gap: var(--nc-space-1);
    margin: 0;
    padding: var(--nc-space-3) var(--nc-space-3) var(--nc-space-3) var(--nc-space-7);
    counter-increment: stage;
  }
  .stage::before {
    content: counter(stage);
    position: absolute;
    inset-block-start: var(--nc-space-3);
    inset-inline-start: 0;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--nc-radius-plate);
    background: var(--nc-color-screen);
    box-shadow: inset 0 0 0 1px var(--nc-color-screen-border);
    color: var(--nc-color-on-screen);
    font-family: var(--nc-font-mono);
    font-stretch: var(--nc-type-code-stretch);
    font-size: var(--sl-text-2xs);
    font-weight: 600;
  }
  .stage:not(:last-child)::after {
    content: '';
    position: absolute;
    inset-block: calc(var(--nc-space-3) + 1.5rem) 0;
    inset-inline-start: 0.7rem;
    width: 0.1rem;
    background: var(--nc-color-border-strong);
  }
  .stage__title { font-size: var(--sl-text-sm); font-weight: 600; }
  .stage__files { display: flex; flex-wrap: wrap; gap: var(--nc-space-2); }
  .stage__files code {
    padding: 0 var(--nc-space-2);
    border-radius: var(--nc-radius-plate);
    background: var(--nc-color-surface-sunken);
    box-shadow: inset 0 0 0 1px var(--nc-color-border-strong);
    font-family: var(--nc-font-mono);
    font-stretch: var(--nc-type-code-stretch);
    font-size: var(--sl-text-xs);
  }
  .stage__note { color: var(--nc-color-text-secondary); font-size: var(--sl-text-xs); line-height: 1.5; }
  .pipeline__note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--nc-space-3);
    color: var(--nc-color-text-secondary);
    font-size: var(--sl-text-xs);
  }

  @media (max-width: 48rem) {
    .pipeline { padding: var(--nc-space-4); }
  }
</style>
