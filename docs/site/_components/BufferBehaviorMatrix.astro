---
// The matrix on /reference/buffer-behavior/: every way of getting memory against what it is, what it does and what you
// hold. It renders the `outcomes` of buffers.json, in file order, the same data "Which buffer?" draws its cards from,
// so the two cannot disagree; BufferBehaviorMatrixTests asserts the same file. Three radio inputs filter the rows with
// CSS `:has()` only: where a browser lacks it, every row shows. Each row is a card, its yes-or-no facts side by side
// where they fit, so no column is hidden at any width. Usage:
// <BufferBehaviorMatrix />
import { Status } from '@ncodegroup/docs/components';
import buffers from '@site/components/data/buffers.json';
import { inline, sitePath, sourceLink, testLink } from '@site/components/lib/evidence';

const matrixTests = sourceLink('BufferBehaviorMatrixTests');
const rows = buffers.outcomes.map((outcome) => {
  const behavior = outcome.behavior as Record<string, boolean | string | null>;
  const text = (key: string) => String(behavior[key] ?? '');
  return {
    id: outcome.id,
    anchor: outcome.anchor,
    name: outcome.name,
    secret: outcome.secret,
    flags: [
      { label: 'Pinned', value: behavior.pinned as boolean | null },
      { label: 'Zeroed on dispose', value: behavior.zeroedOnDispose as boolean | null },
      { label: 'Pooled', value: behavior.pooled as boolean | null },
      { label: 'Takes isSensitive', value: behavior.takesIsSensitive as boolean | null },
      { label: 'Across await or in a field', value: behavior.acrossAwait as boolean | null },
    ],
    texts: [
      { label: 'Where the memory comes from', value: text('source') },
      { label: 'What you hold', value: text('holds') },
      { label: 'The length you see', value: text('length') },
      { label: 'Contents when you get it', value: text('contents') },
      { label: 'After dispose', value: text('afterDispose') },
    ],
    tests: outcome.evidence.map(testLink),
  };
});
const headings = [
  'Buffer',
  'Pinned',
  'Zeroed on dispose',
  'Pooled',
  'Takes `isSensitive`',
  'Across `await` or in a field',
  'Where the memory comes from',
  'What you hold',
  'The length you see',
  'Contents when you get it',
  'After dispose',
  'Evidence',
];
---

<div class="behavior-matrix not-content">
  <fieldset class="behavior-matrix__filter">
    <legend class="behavior-matrix__legend">Show</legend>
    <input class="behavior-matrix__radio behavior-matrix__radio--all" type="radio" name="behavior-matrix-filter" id="behavior-matrix-all" checked />
    <label class="behavior-matrix__chip" for="behavior-matrix-all">All</label>
    <input class="behavior-matrix__radio behavior-matrix__radio--secret" type="radio" name="behavior-matrix-filter" id="behavior-matrix-secret" />
    <label class="behavior-matrix__chip" for="behavior-matrix-secret">For secrets</label>
    <input class="behavior-matrix__radio behavior-matrix__radio--other" type="radio" name="behavior-matrix-filter" id="behavior-matrix-other" />
    <label class="behavior-matrix__chip" for="behavior-matrix-other">For other data</label>
  </fieldset>
  <table class="behavior-matrix__table" aria-label="Buffer behavior matrix">
    <thead>
      <tr>
        {headings.map((heading) => (
          <th scope="col" set:html={inline(heading)} />
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr id={`behavior-${row.id}`} class="behavior-matrix__row" data-secret={row.secret ? 'true' : 'false'}>
          <th scope="row" data-label="Buffer">
            <a href={sitePath(`/start/which-buffer/#${row.anchor}`)} set:html={inline(row.name)} />
          </th>
          {row.flags.map((flag) => (
            <td data-label={flag.label}>
              {flag.value === true && <Status state="success">Yes</Status>}
              {flag.value === false && <Status state="off">No</Status>}
              {flag.value === null || flag.value === undefined ? <span class="behavior-matrix__na">Does not apply</span> : null}
            </td>
          ))}
          {row.texts.map((cell) => (
            <td class="behavior-matrix__text" data-label={cell.label} set:html={inline(cell.value)} />
          ))}
          <td class="behavior-matrix__proof" data-label="Evidence">
            <ul class="behavior-matrix__evidence">
              {row.tests.map((test) => (
                <li>
                  <a href={test.href} rel="noopener"><span class="behavior-matrix__context">{test.context}.</span>{test.label}</a>
                </li>
              ))}
              <li>
                <a href={matrixTests.href} rel="noopener">{matrixTests.label}</a>
              </li>
            </ul>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .behavior-matrix { margin-block: var(--nc-space-5); color: var(--nc-color-text); }
  .behavior-matrix__filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--nc-space-2);
    margin: 0 0 var(--nc-space-4);
    padding: 0;
    border: 0;
  }
  .behavior-matrix__legend {
    float: left;
    margin-inline-end: var(--nc-space-3);
    padding: 0;
    font-size: 0.6875rem;
    font-stretch: var(--nc-type-label-stretch);
    font-weight: 600;
    letter-spacing: var(--nc-type-label-tracking);
    text-transform: uppercase;
    color: var(--nc-color-text-muted);
  }
  .behavior-matrix__radio { position: absolute; width: 1px; height: 1px; margin: 0; opacity: 0; }
  .behavior-matrix__chip {
    padding: var(--nc-space-1) var(--nc-space-4);
    border: var(--nc-border-hair) solid var(--nc-color-border);
    border-radius: var(--nc-radius-plate);
    background: var(--nc-color-surface);
    color: var(--nc-color-text-secondary);
    font-size: var(--sl-text-sm);
    cursor: pointer;
  }
  .behavior-matrix__chip:hover { border-color: var(--nc-color-border-strong); color: var(--nc-color-text); }
  .behavior-matrix__radio:checked + .behavior-matrix__chip {
    border-color: var(--nc-color-primary-text);
    box-shadow: 0 0 0 1px var(--nc-color-primary-text);
    color: var(--nc-color-text);
    font-weight: 600;
  }
  .behavior-matrix__radio:focus-visible + .behavior-matrix__chip { outline: var(--nc-focus-width) solid var(--nc-color-focus); outline-offset: var(--nc-focus-gap); }
  .behavior-matrix__table { display: block; width: 100%; font-size: var(--sl-text-sm); line-height: 1.45; }
  .behavior-matrix__table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .behavior-matrix__table tbody { display: grid; gap: var(--nc-space-4); }
  .behavior-matrix__row {
    scroll-margin-top: calc(var(--sl-nav-height) + var(--nc-space-5));
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: var(--nc-space-3) var(--nc-space-5);
    padding: var(--nc-space-4) var(--nc-space-5);
    border: var(--nc-border-hair) solid var(--nc-color-border);
    border-radius: var(--nc-radius-panel);
    background: var(--nc-color-surface);
  }
  .behavior-matrix__row:target { border-color: var(--nc-color-primary-text); box-shadow: 0 0 0 1px var(--nc-color-primary-text); }
  .behavior-matrix__row > :is(th, td) { display: block; padding: 0; border: 0; text-align: start; }
  .behavior-matrix__row > :is(th, .behavior-matrix__text, .behavior-matrix__proof) { grid-column: 1 / -1; }
  .behavior-matrix__row > th { font-size: var(--sl-text-base); font-weight: 600; }
  .behavior-matrix__row > td::before {
    content: attr(data-label);
    display: block;
    margin-bottom: var(--nc-space-1);
    font-size: 0.6875rem;
    font-stretch: var(--nc-type-label-stretch);
    font-weight: 600;
    letter-spacing: var(--nc-type-label-tracking);
    text-transform: uppercase;
    color: var(--nc-color-text-muted);
  }
  .behavior-matrix__table a { color: var(--nc-color-text); text-decoration-color: var(--nc-color-border-strong); text-underline-offset: 0.2em; overflow-wrap: anywhere; }
  .behavior-matrix__table a:hover { color: var(--nc-color-primary-text); }
  .behavior-matrix__table a:focus-visible { outline: var(--nc-focus-width) solid var(--nc-color-focus); outline-offset: var(--nc-focus-gap); }
  .behavior-matrix :global(code) { font-family: var(--nc-font-mono); font-stretch: var(--nc-type-code-stretch); font-size: 0.88em; overflow-wrap: break-word; }
  .behavior-matrix__na { color: var(--nc-color-text-muted); }
  .behavior-matrix__evidence { margin: 0; padding: 0; list-style: none; font-size: var(--sl-text-xs); }
  .behavior-matrix__evidence li { margin: 0 0 var(--nc-space-1); }
  .behavior-matrix__evidence a { font-family: var(--nc-font-mono); font-stretch: var(--nc-type-code-stretch); }
  .behavior-matrix__context { color: var(--nc-color-text-muted); }

  /* The filter: a row that does not match the checked chip is hidden. Without :has() every row shows. */
  .behavior-matrix:has(.behavior-matrix__radio--secret:checked) .behavior-matrix__row[data-secret='false'],
  .behavior-matrix:has(.behavior-matrix__radio--other:checked) .behavior-matrix__row[data-secret='true'] { display: none; }
</style>
