---
// The matrix on /reference/buffer-behavior/: every way of getting memory against what it is, what it does and what you
// hold. It renders the `outcomes` of buffers.json, in file order, the same data "Which buffer?" draws its cards from,
// so the two cannot disagree; BufferBehaviorMatrixTests asserts the same file. Three radio inputs filter the rows with
// CSS `:has()` only: where a browser lacks it, every row shows. Below 40rem each row is a card. Usage:
// <BufferBehaviorMatrix />
import { Status } from '@ncodegroup/docs/components';
import buffers from '@site/components/data/buffers.json';
import { inline, sitePath, sourceLink, testLink } from '@site/components/lib/evidence';

const matrixTests = sourceLink('BufferBehaviorMatrixTests');
const rows = buffers.outcomes.map((outcome) => {
  const behavior = outcome.behavior as Record<string, boolean | string | null>;
  const text = (key: string) => String(behavior[key] ?? '');
  return {
    id: outcome.id,
    anchor: outcome.anchor,
    name: outcome.name,
    secret: outcome.secret,
    flags: [
      { label: 'Pinned', value: behavior.pinned as boolean | null },
      { label: 'Zeroed on dispose', value: behavior.zeroedOnDispose as boolean | null },
      { label: 'Pooled', value: behavior.pooled as boolean | null },
      { label: 'Takes isSensitive', value: behavior.takesIsSensitive as boolean | null },
      { label: 'Across await or in a field', value: behavior.acrossAwait as boolean | null },
    ],
    texts: [
      { label: 'Where the memory comes from', value: text('source') },
      { label: 'What you hold', value: text('holds') },
      { label: 'The length you see', value: text('length') },
      { label: 'Contents when you get it', value: text('contents') },
      { label: 'After dispose', value: text('afterDispose') },
    ],
    tests: outcome.evidence.map(testLink),
  };
});
const headings = [
  'Buffer',
  'Pinned',
  'Zeroed on dispose',
  'Pooled',
  'Takes `isSensitive`',
  'Across `await` or in a field',
  'Where the memory comes from',
  'What you hold',
  'The length you see',
  'Contents when you get it',
  'After dispose',
  'Evidence',
];
---

<div class="behavior-matrix not-content">
  <fieldset class="behavior-matrix__filter">
    <legend class="behavior-matrix__legend">Show</legend>
    <input class="behavior-matrix__radio behavior-matrix__radio--all" type="radio" name="behavior-matrix-filter" id="behavior-matrix-all" checked />
    <label class="behavior-matrix__chip" for="behavior-matrix-all">All</label>
    <input class="behavior-matrix__radio behavior-matrix__radio--secret" type="radio" name="behavior-matrix-filter" id="behavior-matrix-secret" />
    <label class="behavior-matrix__chip" for="behavior-matrix-secret">For secrets</label>
    <input class="behavior-matrix__radio behavior-matrix__radio--other" type="radio" name="behavior-matrix-filter" id="behavior-matrix-other" />
    <label class="behavior-matrix__chip" for="behavior-matrix-other">For other data</label>
  </fieldset>
  <div class="behavior-matrix__scroll" role="region" aria-label="Buffer behavior matrix" tabindex="0">
    <table class="behavior-matrix__table">
      <thead>
        <tr>
          {headings.map((heading) => (
            <th scope="col" set:html={inline(heading)} />
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr id={`behavior-${row.id}`} class="behavior-matrix__row" data-secret={row.secret ? 'true' : 'false'}>
            <th scope="row" data-label="Buffer">
              <a href={sitePath(`/start/which-buffer/#${row.anchor}`)} set:html={inline(row.name)} />
            </th>
            {row.flags.map((flag) => (
              <td data-label={flag.label}>
                {flag.value === true && <Status state="success">Yes</Status>}
                {flag.value === false && <Status state="off">No</Status>}
                {flag.value === null || flag.value === undefined ? <span class="behavior-matrix__na">Does not apply</span> : null}
              </td>
            ))}
            {row.texts.map((cell) => (
              <td data-label={cell.label} set:html={inline(cell.value)} />
            ))}
            <td data-label="Evidence">
              <ul class="behavior-matrix__evidence">
                {row.tests.map((test) => (
                  <li>
                    <a href={test.href} rel="noopener"><span class="behavior-matrix__context">{test.context}.</span>{test.label}</a>
                  </li>
                ))}
                <li>
                  <a href={matrixTests.href} rel="noopener">{matrixTests.label}</a>
                </li>
              </ul>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<style>
  .behavior-matrix { margin-block: var(--space-5); color: var(--color-text); }
  .behavior-matrix__filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    padding: 0;
    border: 0;
  }
  .behavior-matrix__legend {
    float: left;
    margin-inline-end: var(--space-3);
    padding: 0;
    font-size: var(--text-2xs);
    font-stretch: var(--width-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .behavior-matrix__radio { position: absolute; width: 1px; height: 1px; margin: 0; opacity: 0; }
  .behavior-matrix__chip {
    padding: var(--space-1) var(--space-4);
    border: var(--border-hair) solid var(--color-border);
    border-radius: var(--radius-plate);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    font-size: var(--text-md);
    cursor: pointer;
  }
  .behavior-matrix__chip:hover { border-color: var(--color-border-strong); color: var(--color-text); }
  .behavior-matrix__radio:checked + .behavior-matrix__chip {
    border-color: var(--color-primary-text);
    box-shadow: 0 0 0 1px var(--color-primary-text);
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }
  .behavior-matrix__radio:focus-visible + .behavior-matrix__chip { outline: var(--focus-width) solid var(--color-focus); outline-offset: var(--focus-gap); }
  .behavior-matrix__scroll { overflow-x: auto; }
  .behavior-matrix__scroll:focus-visible { outline: var(--focus-width) solid var(--color-focus); outline-offset: var(--focus-gap); }
  .behavior-matrix__table {
    width: 100%;
    min-width: 72rem;
    border-collapse: collapse;
    font-size: var(--text-md);
    line-height: var(--leading-snug);
  }
  .behavior-matrix__table th,
  .behavior-matrix__table td { padding: var(--space-3); border-bottom: var(--border-hair) solid var(--color-border); text-align: start; vertical-align: top; }
  .behavior-matrix__table thead th {
    font-size: var(--text-2xs);
    font-stretch: var(--width-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .behavior-matrix__table tbody th { font-weight: var(--weight-semibold); }
  .behavior-matrix__row { scroll-margin-top: calc(var(--sl-nav-height) + var(--space-5)); }
  .behavior-matrix__row:target { background: var(--color-surface-sunken); }
  .behavior-matrix__table a { color: var(--color-text); text-decoration-color: var(--color-border-strong); text-underline-offset: 0.2em; overflow-wrap: anywhere; }
  .behavior-matrix__table a:hover { color: var(--color-primary-text); }
  .behavior-matrix__table a:focus-visible { outline: var(--focus-width) solid var(--color-focus); outline-offset: var(--focus-gap); }
  .behavior-matrix :global(code) { font-family: var(--font-mono); font-stretch: var(--width-code); font-size: 0.88em; }
  .behavior-matrix__na { color: var(--color-text-muted); }
  .behavior-matrix__evidence { margin: 0; padding: 0; list-style: none; font-size: var(--text-sm); }
  .behavior-matrix__evidence li { margin: 0 0 var(--space-1); }
  .behavior-matrix__evidence a { font-family: var(--font-mono); font-stretch: var(--width-code); }
  .behavior-matrix__context { color: var(--color-text-muted); }

  /* The filter: a row that does not match the checked chip is hidden. Without :has() every row shows. */
  .behavior-matrix:has(.behavior-matrix__radio--secret:checked) .behavior-matrix__row[data-secret='false'],
  .behavior-matrix:has(.behavior-matrix__radio--other:checked) .behavior-matrix__row[data-secret='true'] { display: none; }

  @media (max-width: 40rem) {
    .behavior-matrix__table { min-width: 0; }
    .behavior-matrix__table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .behavior-matrix__table,
    .behavior-matrix__table tbody,
    .behavior-matrix__table th,
    .behavior-matrix__table td { display: block; }
    .behavior-matrix__table .behavior-matrix__row {
      display: block;
      margin-bottom: var(--space-4);
      padding: var(--space-4);
      border: var(--border-hair) solid var(--color-border);
      border-radius: var(--radius-panel);
      background: var(--color-surface);
    }
    .behavior-matrix__table th,
    .behavior-matrix__table td { padding: var(--space-1) 0; border: 0; }
    .behavior-matrix__table td::before,
    .behavior-matrix__table th[data-label]::before {
      content: attr(data-label);
      display: block;
      font-size: var(--text-2xs);
      font-stretch: var(--width-label);
      font-weight: var(--weight-semibold);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
      color: var(--color-text-muted);
    }
    .behavior-matrix:has(.behavior-matrix__radio--secret:checked) .behavior-matrix__table .behavior-matrix__row[data-secret='false'],
    .behavior-matrix:has(.behavior-matrix__radio--other:checked) .behavior-matrix__table .behavior-matrix__row[data-secret='true'] { display: none; }
  }
</style>
