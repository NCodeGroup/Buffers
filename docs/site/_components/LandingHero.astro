---
// The landing page's hero, after the brand's hero mockup: the eyebrow above the headline, the lead and the line on
// what the library does not do at the same size, and beside them the drawing of a key being overwritten with zeros.
//
// Starlight renders the hero from the page's frontmatter (`hero.title`, `hero.tagline`, `hero.image.html`), so the
// markup lives there, and this component holds only its styles. Render it once, at the top of docs/site/index.mdx;
// it outputs nothing visible. The classes it styles:
//   .landing-eyebrow   in hero.title, above the headline
//   .landing-limit     the second paragraph of hero.tagline
//   .landing-monitor   hero.image.html: lamps, a screen of 32 cells between braces, a caption
//     .lm-cell--zero, .lm-cell--cursor, .lm-cell--key   a zeroed cell, the cell zeroed last, a cell that still holds the key
//   .landing-badges    a <div> around the page's badges, which it sets in one row that wraps
// The drawing is static: nothing moves on its own. The brace marks the lifetime of the secret, as the
// brand's brace rule allows.
---

<span class="landing-hero" hidden></span>

<style is:global>
  .hero .landing-eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: var(--nc-space-2) var(--nc-space-3);
    margin-bottom: var(--nc-space-5);
    color: var(--nc-color-text-secondary);
    font-family: var(--nc-font-sans);
    font-size: var(--sl-text-xs);
    font-stretch: var(--nc-type-label-stretch);
    font-weight: 600;
    letter-spacing: var(--nc-type-label-tracking);
    line-height: 1.4;
    text-transform: uppercase;
  }
  .hero .landing-eyebrow > span + span::before {
    content: '·';
    margin-inline-end: var(--nc-space-3);
    color: var(--nc-color-text-muted);
  }
  .hero .tagline p + p { margin-top: var(--nc-space-4); }
  .hero .tagline .landing-limit { color: var(--nc-color-text); }

  /* Below 72rem, where the sidebar leaves the hero too narrow for two columns, the drawing follows the copy, at the copy's width; from 72rem it stands in the hero's second column. */
  .hero > .hero-html {
    order: 2;
    width: 100%;
    max-width: 26rem;
    margin-inline: 0;
  }
  @media (min-width: 50rem) {
    .hero > .hero-html { width: 100%; max-width: 26rem; justify-self: end; }
  }
  @media (min-width: 50rem) and (max-width: 71.99rem) {
    .hero:has(.landing-eyebrow) { grid-template-columns: minmax(0, 1fr); }
    .hero:has(.landing-eyebrow) > .hero-html { justify-self: start; }
  }
  /* Starlight sizes the card grid's two columns to their content, so a long test name in a card would widen the page beside the sidebar; minmax(0, 1fr) lets each card shrink and the name end in an ellipsis. */
  @media (min-width: 50rem) {
    [data-has-hero] .card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .landing-monitor {
    display: flex;
    flex-direction: column;
    gap: var(--nc-space-4);
    width: 100%;
    margin: 0;
    padding: var(--nc-space-4);
    border: var(--nc-border-hair) solid var(--nc-color-border);
    border-radius: var(--nc-radius-panel);
    background: var(--nc-color-surface-raised);
    box-shadow: var(--nc-elevation-raised);
  }
  .landing-monitor__lamps {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--nc-space-3) var(--nc-space-5);
    color: var(--nc-color-text-secondary);
    font-size: var(--sl-text-xs);
    font-stretch: var(--nc-type-label-stretch);
    font-weight: 600;
    letter-spacing: var(--nc-type-label-tracking);
    text-transform: uppercase;
  }
  .landing-monitor__lamps .ncode-readout { margin-inline-start: auto; text-transform: none; letter-spacing: normal; }
  .landing-monitor__screen {
    display: flex;
    flex-direction: column;
    gap: var(--nc-space-3);
    padding: var(--nc-space-4);
    border-radius: var(--nc-radius-module);
    background: var(--nc-color-screen);
    color: var(--nc-color-on-screen-secondary);
    font-family: var(--nc-font-mono);
    font-stretch: var(--nc-type-code-stretch);
  }
  .landing-monitor__head {
    display: flex;
    justify-content: space-between;
    gap: var(--nc-space-3);
    color: var(--nc-color-on-screen-muted);
    font-size: var(--sl-text-2xs);
  }
  .landing-monitor__memory { display: flex; align-items: stretch; gap: var(--nc-space-2); }
  .landing-monitor__offsets {
    display: grid;
    grid-template-rows: repeat(4, 1fr);
    gap: 3px;
    color: var(--nc-color-on-screen-muted);
    font-size: var(--sl-text-2xs);
  }
  .landing-monitor__offsets > span { display: flex; align-items: center; }
  .landing-monitor__brace { display: flex; color: var(--nc-color-screen-lit); }
  .landing-monitor__brace--right { transform: scaleX(-1); }
  .landing-monitor__brace .brace { display: inline-flex; flex-direction: column; align-items: flex-start; width: 10px; }
  .landing-monitor__brace svg { display: block; fill: currentColor; overflow: visible; }
  .landing-monitor__brace .brace__hook { width: 10px; height: 5px; }
  .landing-monitor__brace .brace__cusp { width: 5px; height: 7px; }
  .landing-monitor__brace .brace__stem { flex: 1 1 0; width: 2px; margin-inline-start: 3px; background: currentColor; }
  .landing-monitor__cells {
    flex: 1 1 auto;
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 3px;
  }
  .lm-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1.15;
    border-radius: var(--nc-radius-cell);
    font-size: var(--sl-text-xs);
    font-weight: 500;
  }
  .lm-cell--zero { box-shadow: inset 0 0 0 1px var(--nc-color-screen-border); color: var(--nc-color-on-screen-muted); }
  .lm-cell--cursor { box-shadow: inset 0 0 0 2px var(--nc-color-screen-lit); color: var(--nc-color-screen-lit); }
  .lm-cell--key {
    background: color-mix(in srgb, var(--nc-color-screen-hot) 16%, var(--nc-color-screen-raised));
    color: var(--nc-color-screen-hot);
  }
  .landing-monitor figcaption {
    color: var(--nc-color-text-secondary);
    font-size: var(--sl-text-xs);
    line-height: 1.5;
  }
  .landing-monitor figcaption code { font-size: 0.95em; }
  .landing-badges > p { display: flex; flex-wrap: wrap; gap: var(--nc-space-2) var(--nc-space-3); margin: 0; }
  .landing-badges a { display: inline-flex; }
  .landing-badges img { display: block; height: 1.25rem; width: auto; }
  @media (max-width: 24rem) {
    .lm-cell { font-size: var(--sl-text-2xs); }
  }
</style>
