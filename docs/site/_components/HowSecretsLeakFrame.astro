---
// The small picture beside each leak card on /concepts/how-secrets-leak/: the leak drawn in the memory strip's cells,
// as rows that each name a moment and show what memory holds then. Wrap the card in it:
//   <HowSecretsLeakFrame leak="L3">
//     <LeakCard leak="L3" variant="full" id="pools-pass-your-bytes-on" />
//   </HowSecretsLeakFrame>
// The rows draw what the card's receipt asserts: the same bytes (0x5A where the sample fills a key with it), the same
// steps. The caption repeats the card in one sentence, so the picture carries no fact the text does not. Static: no
// script, nothing moves.
//
// A row's cells are tokens separated by spaces: `s:5A` the key, `x:5A` an old copy of it, `0` zeros, `o` other
// data, `.` free memory, `v:61` an ordinary value, `w:80` a value the reader should look at. Text fields take `code`.
import KindMark from '@site/components/KindMark.astro';
import { inline, leak as findLeak } from '@site/components/lib/evidence';

interface Props {
  leak: string;
}
type Row = { label: string; cells: string; out?: string; note?: string };
type Bar = { label: string; guess: string; early: number };
type Frame = { title: string; rows?: Row[]; bars?: Bar[]; caption: string; model?: string };

const key = 's:4B s:A7 s:1C s:E9';
const stale = 'x:4B x:A7 x:1C x:E9';
const fill = (token: string, count: number) => Array(count).fill(token).join(' ');

const frames: Record<string, Frame> = {
  L1: {
    title: 'A compacting collection',
    rows: [
      { label: 'Before', cells: `o o ${key} o o` },
      { label: 'After: the old address', cells: `o o ${stale} . .` },
      { label: 'After: the new address', cells: `o o o o ${key}` },
    ],
    caption: 'The collector copies the array to a new address. The old cells keep the key until something is written over them.',
  },
  L2: {
    title: 'An owner dropped without `Dispose`',
    rows: [
      { label: 'In use', cells: fill('s:5A', 8) },
      { label: 'After two collections and the finalizers', cells: fill('s:5A', 8), note: 'Not zeroed' },
    ],
    caption: 'Nothing disposed the owner, so nothing zeroed the buffer: the bytes are still there after the collections.',
  },
  L3: {
    title: '`ArrayPool<byte>` and two renters',
    rows: [
      { label: 'First renter: `Rent(32)`, then the key', cells: fill('s:5A', 8) },
      { label: '`Return(first)`: in the pool', cells: fill('s:5A', 8) },
      { label: 'Second renter: `Rent(32)`', cells: fill('s:5A', 8), note: 'The same array' },
    ],
    caption: '`Return` leaves the bytes in the array, and the next `Rent` hands that array to the next caller.',
  },
  L4: {
    title: '`ArrayBufferWriter<byte>` grows',
    rows: [
      { label: '16 bytes, in a 16-byte array', cells: key },
      { label: '16 more: a new, larger array', cells: `${key} s:30 s:D5 s:82 s:6F` },
      { label: 'The 16-byte array, dropped', cells: stale },
    ],
    caption: 'Growing allocates a larger array and copies into it. The smaller one is dropped with the first 16 bytes in it.',
  },
  L5: {
    title: 'One secret, three strings',
    rows: [
      { label: 'The string you were given', cells: 's:p s:a s:s s:s s:w s:d' },
      { label: '`Encoding.UTF8.GetBytes(secret)`', cells: 's:70 s:61 s:73 s:73 s:77 s:64' },
      { label: '`$"pw={secret}"`', cells: 'v:p v:w v:= s:p s:a s:s s:s s:w s:d' },
    ],
    caption: 'Your code cannot overwrite a string, and every conversion makes one more place that holds the secret.',
  },
  L6: {
    title: '`Decrypt` throws',
    rows: [
      { label: '`ZeroMemory` written after the call', cells: fill('s:5A', 8), note: 'Never ran' },
      { label: 'In a `using` scope', cells: fill('0', 8) },
    ],
    caption: 'The exception skips the line that would have cleared the array. The `using` scope zeroes on the way out.',
  },
  L7: {
    title: 'Guessing a 4-byte value',
    bars: [
      { label: '0 right', guess: 'w:00 v:00 v:00 v:00', early: 1 },
      { label: '1 right', guess: 's:4B w:00 v:00 v:00', early: 2 },
      { label: '2 right', guess: 's:4B s:A7 w:00 v:00', early: 3 },
      { label: '3 right', guess: 's:4B s:A7 s:1C w:00', early: 4 },
      { label: '4 right', guess: key, early: 4 },
    ],
    caption: 'A comparison that stops at the first difference does more work the more leading bytes are right. A fixed-time one does the same work for every guess of the same length.',
    model: 'A model: it counts byte comparisons and does not measure .NET.',
  },
  L8: {
    title: 'Two inputs, one string',
    rows: [
      { label: 'Bytes `61 80`, through `Encoding.UTF8`', cells: 'v:61 w:80', out: 'v:a w:�' },
      { label: 'Bytes `61 FF`, through `Encoding.UTF8`', cells: 'v:61 w:FF', out: 'v:a w:�' },
    ],
    caption: 'Neither input is valid UTF-8, and both decode to `a` followed by U+FFFD. `SecureEncoding.UTF8` throws on both.',
  },
  L9: {
    title: 'A copy taken before `Dispose`',
    rows: [
      { label: 'The pinned array, after `Dispose`', cells: fill('0', 8) },
      { label: 'Its `ToArray()` copy', cells: fill('s:5A', 8) },
    ],
    caption: '`Dispose` writes zeros to the memory it owns. The copy is other memory, and it keeps the key.',
  },
};

const { leak: id } = Astro.props;
const card = findLeak(id);
const frame = frames[id];
if (!frame) throw new Error(`[how-secrets-leak frame] no frame for ${id}`);

const kinds: Record<string, string> = { s: 'secret', x: 'stale', '0': 'zero', o: 'other', '.': 'free', v: 'value', w: 'warn' };
function cells(tokens: string) {
  return tokens.split(/\s+/).map((token) => {
    const [code, text = code === '0' ? '00' : ''] = token.split(':');
    const kind = kinds[code];
    if (!kind) throw new Error(`[how-secrets-leak frame] ${id}: unknown cell "${token}"`);
    return { kind, text };
  });
}
---

<div class="pair">
  <slot />
  <figure class="frame not-content" aria-labelledby={`frame-${id}-caption`}>
    <div class="frame__screen" aria-hidden="true">
      <p class="frame__title" set:html={inline(frame.title)} />
      {frame.rows?.map((row) => (
        <div class="frame__row">
          <p class="frame__label">
            <span set:html={inline(row.label)} />
            {row.note && <span class="frame__note">{row.note}</span>}
          </p>
          <div class="frame__line">
            <div class="frame__cells">
              {cells(row.cells).map((cell) => <span class:list={['cell', `cell--${cell.kind}`]}>{cell.text}</span>)}
            </div>
            {row.out && (
              <>
                <span class="frame__arrow">→</span>
                <div class="frame__cells">
                  {cells(row.out).map((cell) => <span class:list={['cell', `cell--${cell.kind}`]}>{cell.text}</span>)}
                </div>
              </>
            )}
          </div>
        </div>
      ))}
      {frame.bars && (
        <div class="bars">
          <p class="bars__head">Guess</p>
          <p class="bars__head">Stops at the first difference</p>
          <p class="bars__head">Fixed time</p>
          {frame.bars.map((bar) => (
            <>
              <div class="bars__guess">
                <span class="frame__label">{bar.label}</span>
                <div class="frame__cells frame__cells--four">
                  {cells(bar.guess).map((cell) => <span class:list={['cell', `cell--${cell.kind}`]}>{cell.text}</span>)}
                </div>
              </div>
              <div class="bars__meter" data-label="Stops early">
                {[1, 2, 3, 4].map((n) => <span class:list={['tick', n <= bar.early && 'tick--on']} />)}
                <span class="bars__count">{bar.early}</span>
              </div>
              <div class="bars__meter" data-label="Fixed">
                {[1, 2, 3, 4].map(() => <span class="tick tick--on" />)}
                <span class="bars__count">4</span>
              </div>
            </>
          ))}
        </div>
      )}
    </div>
    <figcaption class="frame__caption" id={`frame-${id}-caption`}>
      <span class="sr-only">{card.title}, drawn: </span>
      <span set:html={inline(frame.caption)} />
      <span class="frame__kind">
        <KindMark kind="illustration" variant="bare" />
        <span>{frame.model ?? 'A drawing of the mechanism, not a trace of a real process.'}</span>
      </span>
    </figcaption>
  </figure>
</div>

<style>
  .pair { margin-block: var(--nc-space-6); }
  .pair > :global(.leak--full) { margin-block: 0; border-end-start-radius: 0; border-end-end-radius: 0; }
  .frame {
    display: grid;
    gap: var(--nc-space-3);
    margin: 0;
    padding: var(--nc-space-4) var(--nc-space-5) var(--nc-space-5);
    border: var(--nc-border-hair) solid var(--nc-color-border);
    border-top: 0;
    border-end-start-radius: var(--nc-radius-panel);
    border-end-end-radius: var(--nc-radius-panel);
    background: var(--nc-color-surface-sunken);
    color: var(--nc-color-text);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .frame p { margin: 0; }
  .frame__screen {
    display: grid;
    gap: var(--nc-space-4);
    padding: var(--nc-space-4);
    border-radius: var(--nc-radius-panel);
    background: var(--nc-color-screen);
    color: var(--nc-color-on-screen);
  }
  .frame__title { font-size: var(--sl-text-sm); font-weight: 600; }
  .frame__row { display: grid; gap: var(--nc-space-2); }
  .frame__label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--nc-space-1) var(--nc-space-3);
    font-size: var(--sl-text-xs);
    color: var(--nc-color-on-screen-secondary);
  }
  .frame__label :global(code),
  .frame__title :global(code) { font-family: var(--nc-font-mono); font-stretch: var(--nc-type-code-stretch); font-size: 0.92em; color: var(--nc-color-on-screen); }
  .frame__note {
    font-size: 0.6875rem;
    font-stretch: var(--nc-type-label-stretch);
    font-weight: 600;
    letter-spacing: var(--nc-type-label-tracking);
    text-transform: uppercase;
    color: var(--nc-color-screen-hot);
  }
  .frame__line { display: flex; align-items: center; gap: var(--nc-space-3); min-width: 0; }
  .frame__cells { display: grid; grid-template-columns: repeat(auto-fill, minmax(1.875rem, 1fr)); gap: 3px; flex: 1 1 auto; min-width: 0; max-width: 24rem; }
  .frame__line:has(.frame__arrow) .frame__cells { flex: 0 1 auto; grid-template-columns: repeat(2, 2.25rem); }
  .frame__cells--four { grid-template-columns: repeat(4, 2rem); max-width: none; }
  .frame__arrow { color: var(--nc-color-on-screen-muted); font-family: var(--nc-font-mono); }

  .cell {
    display: grid;
    place-items: center;
    height: 1.625rem;
    border-radius: var(--nc-radius-cell);
    font-family: var(--nc-font-mono);
    font-stretch: var(--nc-type-code-stretch);
    font-size: var(--sl-text-2xs);
    font-weight: 500;
    line-height: 1;
    font-feature-settings: 'zero' 1;
  }
  .cell--free { box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--nc-color-screen-border) 60%, transparent); }
  .cell--other { background: var(--nc-color-screen-raised); }
  .cell--secret { background: color-mix(in srgb, var(--nc-color-screen-hot) 16%, var(--nc-color-screen-raised)); color: var(--nc-color-screen-hot); }
  .cell--stale {
    background: repeating-linear-gradient(135deg, color-mix(in srgb, var(--nc-color-screen-hot) 22%, transparent) 0 3px, transparent 3px 6px), var(--nc-color-screen-raised);
    color: color-mix(in srgb, var(--nc-color-screen-hot) 80%, var(--nc-color-on-screen-muted));
  }
  .cell--zero { box-shadow: inset 0 0 0 1px var(--nc-color-screen-border); color: var(--nc-color-on-screen-muted); }
  .cell--value { background: var(--nc-color-screen-raised); color: var(--nc-color-screen-lit); }
  .cell--warn { box-shadow: inset 0 0 0 1.5px var(--nc-color-screen-hot); color: var(--nc-color-screen-hot); background: var(--nc-color-screen-raised); }

  /* The timing model: a guess, then the comparisons each method makes, as four ticks. */
  .bars { display: grid; grid-template-columns: auto minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: var(--nc-space-3) var(--nc-space-4); }
  .bars__head {
    font-size: 0.6875rem;
    font-stretch: var(--nc-type-label-stretch);
    font-weight: 600;
    letter-spacing: var(--nc-type-label-tracking);
    text-transform: uppercase;
    color: var(--nc-color-on-screen-muted);
  }
  .bars__guess { display: grid; gap: var(--nc-space-1); }
  .bars__meter { display: flex; align-items: center; gap: 3px; }
  .tick { width: 0.75rem; height: 1.25rem; border-radius: var(--nc-radius-cell); box-shadow: inset 0 0 0 1px var(--nc-color-screen-border); }
  .tick--on { background: var(--nc-color-screen-lit); box-shadow: none; }
  .bars__count { margin-inline-start: var(--nc-space-2); font-family: var(--nc-font-mono); font-size: var(--sl-text-2xs); color: var(--nc-color-on-screen-secondary); }

  .frame__caption { display: grid; gap: var(--nc-space-2); font-size: var(--sl-text-sm); line-height: 1.5; text-wrap: pretty; }
  .frame__caption :global(code) {
    padding: 0.06em 0.3em;
    border: var(--nc-border-hair) solid var(--nc-color-border);
    border-radius: var(--nc-radius-plate);
    background: var(--nc-color-surface);
    font-family: var(--nc-font-mono);
    font-stretch: var(--nc-type-code-stretch);
    font-size: 0.88em;
  }
  .frame__kind { display: flex; flex-wrap: wrap; align-items: center; gap: var(--nc-space-3); color: var(--nc-color-text-secondary); font-size: var(--sl-text-xs); }

  @media (max-width: 40rem) {
    .frame { padding: var(--nc-space-3) var(--nc-space-4) var(--nc-space-4); }
    .frame__screen { padding: var(--nc-space-3); }
    .bars { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); row-gap: var(--nc-space-2); }
    .bars__head { display: none; }
    .bars__guess { grid-column: 1 / -1; grid-template-columns: 4.5rem auto; align-items: center; margin-top: var(--nc-space-2); }
    .bars__meter::before {
      content: attr(data-label);
      margin-inline-end: var(--nc-space-2);
      font-size: 0.6875rem;
      color: var(--nc-color-on-screen-muted);
    }
    .frame__cells--four { grid-template-columns: repeat(4, 1.875rem); }
  }
</style>
