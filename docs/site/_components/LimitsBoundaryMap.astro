---
// The boundary map of /start/limits/: where a secret can be, inside your process and outside it. The pinned heap is
// the one place the library's buffers live; every other place carries the numbers of the limits on the page that
// concern it, so the picture and the list say the same thing. The brace marks the one security boundary drawn here,
// the process the library runs in. A static drawing: no script, the same in print.
// Usage: <LimitsBoundaryMap />, after the numbered list of limits it cites.
import KindMark from '@site/components/KindMark.astro';
import Brace from '@site/components/Brace.astro';

const inside = [
  { name: 'Pinned heap', note: "The library's buffers: one place, not moved, zeroed on dispose", entries: [3, 6], lit: true },
  { name: 'Collected heap', note: 'Arrays and strings your code makes, which the collector can move', entries: [5, 7] },
  { name: 'Stack', note: '`stackalloc` memory does not move; copies the compiler makes are not zeroed', entries: [8] },
  { name: 'Registers', note: 'The processor works on the key here while it is in use', entries: [3, 8] },
  { name: 'Native memory', note: 'Memory of native libraries, such as the operating system’s cryptography', entries: [8] },
];
const outside = [
  { name: 'Page file and swap', entries: [1] },
  { name: 'Hibernation file', entries: [1] },
  { name: 'Crash dump', entries: [2] },
  { name: 'Debugger', entries: [2] },
  { name: 'Another process', entries: [2] },
];
const code = (text: string) => text.replace(/`([^`]+)`/g, '<code>$1</code>');
---

<figure class="map not-content" aria-labelledby="limits-map-title">
  <p class="map__title" id="limits-map-title">Where a secret can be</p>
  <div class="map__body">
    <section class="map__process" aria-label="Inside your process">
      <Brace side="left" />
      <div class="map__inside">
        <p class="map__label">Your process: the library runs here, with your privileges</p>
        <ul class="map__places">
          {inside.map((place) => (
            <li class:list={['place', place.lit && 'place--lit']}>
              <span class="place__name">{place.name}</span>
              <span class="place__note" set:html={code(place.note)} />
              <span class="place__entries" role="img" aria-label={`Limits ${place.entries.join(' and ')}`}>
                {place.entries.map((n) => <span class="entry">{n}</span>)}
              </span>
            </li>
          ))}
        </ul>
      </div>
      <Brace side="right" />
    </section>
    <section class="map__outside" aria-label="Outside your process">
      <p class="map__label">Outside it, where memory can be read or written down</p>
      <ul class="map__places">
        {outside.map((place) => (
          <li class="place place--outside">
            <span class="place__name">{place.name}</span>
            <span class="place__entries" role="img" aria-label={`Limit ${place.entries.join(' and ')}`}>
              {place.entries.map((n) => <span class="entry">{n}</span>)}
            </span>
          </li>
        ))}
      </ul>
    </section>
  </div>
  <p class="map__note">
    <KindMark kind="illustration" />
    <span>A drawing of where memory can be, not a trace of a real process. The numbers are the limits listed above.</span>
  </p>
</figure>

<style>
  .map {
    display: grid;
    gap: var(--space-4);
    margin-block: var(--space-6);
    padding: var(--space-5);
    border: var(--border-hair) solid var(--color-border);
    border-radius: var(--radius-panel);
    background: var(--color-surface);
    box-shadow: var(--elevation-flush);
    color: var(--color-text);
  }
  .map p { margin: 0; }
  .map__title {
    font-size: var(--text-lg);
    font-stretch: var(--width-display);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }
  .map__body { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: var(--space-5); align-items: stretch; }
  .map__label {
    font-size: var(--text-2xs);
    font-stretch: var(--width-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .map__process { display: flex; align-items: stretch; gap: var(--space-3); color: var(--color-primary-text); }
  .map__inside { flex: 1 1 auto; display: grid; gap: var(--space-3); align-content: start; color: var(--color-text); }
  .map__outside {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-4);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-control);
  }
  .map__places { display: grid; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
  .place {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'name entries' 'note entries';
    align-items: center;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    padding: var(--space-3);
    border: var(--border-hair) solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-surface-raised);
  }
  .place--outside { grid-template-areas: 'name entries'; background: transparent; }
  .place__name { grid-area: name; font-size: var(--text-md); font-weight: var(--weight-semibold); }
  .place__note { grid-area: note; color: var(--color-text-secondary); font-size: var(--text-sm); line-height: var(--leading-normal); }
  .place__note :global(code) { font-family: var(--font-mono); font-stretch: var(--width-code); font-size: 0.92em; }
  .place__entries { grid-area: entries; display: flex; gap: var(--space-1); }
  .entry {
    display: grid;
    place-items: center;
    min-width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--radius-plate);
    background: var(--color-surface-sunken);
    box-shadow: inset 0 0 0 1px var(--color-border-strong);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-stretch: var(--width-code);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }
  .place--lit {
    border-color: transparent;
    background: var(--color-screen);
    color: var(--color-on-screen);
  }
  .place--lit .place__name { color: var(--color-screen-lit); }
  .place--lit .place__note { color: var(--color-on-screen-secondary); }
  .place--lit .entry { background: var(--color-screen-raised); box-shadow: inset 0 0 0 1px var(--color-screen-border); color: var(--color-on-screen); }
  .map__note { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); color: var(--color-text-secondary); font-size: var(--text-sm); }

  @media (max-width: 48rem) {
    .map { padding: var(--space-4); }
    .map__body { grid-template-columns: minmax(0, 1fr); }
  }
</style>
