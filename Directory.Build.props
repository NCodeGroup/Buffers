<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!-- Shared settings from the project template; this file's own settings, after the import, override them. -->
  <Import Project="$(MSBuildThisFileDirectory)build/ProjectTemplate.props" />

  <!-- Nerdbank.GitVersioning stamps every assembly and package from version.json, which also holds the 4.x AssemblyVersion, 4.1.0.0 (ADR-1000). -->
  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all" />
  </ItemGroup>
</Project>
