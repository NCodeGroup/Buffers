<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Shared settings from the project template; this file's own settings, after the import, override them. -->
  <Import Project="$(MSBuildThisFileDirectory)build/ProjectTemplate.props" />

  <!-- Shipping code takes encodings from SecureEncoding and buffers from BufferFactory (ADR-1003); test projects compare against the standard ones. -->
  <ItemGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Encoding.txt" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Buffers.txt" />
  </ItemGroup>
</Project>
